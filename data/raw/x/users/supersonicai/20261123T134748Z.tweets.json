{"data":[{"created_at":"2026-11-21T21:00:13.000Z","edit_history_tweet_ids":["2124246526499361067"],"id":"2124246526499361067","lang":"en","public_metrics":{"bookmark_count":2,"impression_count":722,"like_count":7,"quote_count":0,"reply_count":0,"retweet_count":0},"referenced_tweets":[{"id":"2124246523819233518","type":"replied_to"}],"text":"That’s it for today. We’re excited to see what you build with Julia. If you try it on your own tasks, we’d love to hear what works and where it falls short."},{"created_at":"2026-11-21T21:00:12.000Z","edit_history_tweet_ids":["2124246523819233518"],"entities":{"urls":[{"description":"Decisions from text, images, and live audio. Compare Julia 2, Flash, and Nano, with benchmarks and quickstarts.","display_url":"supersoniclabs.ai/julia-2","end":152,"expanded_url":"https://supersoniclabs.ai/julia-2","images":[{"height":630,"url":"https://pbs.twimg.com/news_img/2124246588126330880/7RtPUnh2?format=jpg&name=orig","width":1200},{"height":150,"url":"https://pbs.twimg.com/news_img/2124246588126330880/7RtPUnh2?format=jpg&name=150x150","width":150}],"start":129,"status":200,"title":"Julia 2, Flash and Nano | Supersonic Labs","unwound_url":"https://supersoniclabs.ai/julia-2/","url":"https://t.co/24tqeS3kOm"},{"description":"A compact text decision model with stronger rule following. See benchmarks, migration, and Python examples.","display_url":"supersoniclabs.ai/julia-1.5","end":187,"expanded_url":"https://supersoniclabs.ai/julia-1.5","images":[{"height":630,"url":"https://pbs.twimg.com/news_img/2124246589145571329/N7yYIiX9?format=jpg&name=orig","width":1200},{"height":150,"url":"https://pbs.twimg.com/news_img/2124246589145571329/N7yYIiX9?format=jpg&name=150x150","width":150}],"start":164,"status":200,"title":"Julia 1.5 | Supersonic Labs","unwound_url":"https://supersoniclabs.ai/julia-1.5/","url":"https://t.co/tQDXAlO88B"},{"description":"The Supersonic Labs Classification Models Benchmark measures decision quality and sensitivity to option order.","display_url":"supersoniclabs.ai/slcmb","end":218,"expanded_url":"https://supersoniclabs.ai/slcmb","images":[{"height":630,"url":"https://pbs.twimg.com/news_img/2124246589535567872/dSUyUs0s?format=jpg&name=orig","width":1200},{"height":150,"url":"https://pbs.twimg.com/news_img/2124246589535567872/dSUyUs0s?format=jpg&name=150x150","width":150}],"start":195,"status":200,"title":"SLCMB | Supersonic Labs","unwound_url":"https://supersoniclabs.ai/slcmb/","url":"https://t.co/aQ09451Rtv"}]},"id":"2124246523819233518","lang":"en","public_metrics":{"bookmark_count":5,"impression_count":865,"like_count":11,"quote_count":0,"reply_count":1,"retweet_count":1},"referenced_tweets":[{"id":"2124246520853618909","type":"replied_to"}],"text":"We’ll share the full details on our site, including what’s new in each model, how to get started, and how SLCMB works.\n\nJulia 2: https://t.co/24tqeS3kOm\nJulia 1.5: https://t.co/tQDXAlO88B\nSLCMB: https://t.co/aQ09451Rtv"},{"created_at":"2026-11-21T21:00:11.000Z","edit_history_tweet_ids":["2124246520853618909"],"entities":{"urls":[{"description":"Text Classification model with 0.1B parameters. Download, explore files and run it on Hugging Face.","display_url":"huggingface.co/SupersonicLabs…","end":239,"expanded_url":"https://huggingface.co/SupersonicLabs/Julia-1.5","images":[{"height":648,"url":"https://pbs.twimg.com/news_img/2124246539967111169/o4QFUk2A?format=jpg&name=orig","width":1200},{"height":150,"url":"https://pbs.twimg.com/news_img/2124246539967111169/o4QFUk2A?format=jpg&name=150x150","width":150}],"start":216,"status":200,"title":"SupersonicLabs/Julia-1.5 · Hugging Face","unwound_url":"https://huggingface.co/SupersonicLabs/Julia-1.5","url":"https://t.co/sI6B47DIQX"},{"description":"Image-Text-to-Text model with 1B parameters. Download, explore files and run it on Hugging Face.","display_url":"huggingface.co/SupersonicLabs…","end":272,"expanded_url":"https://huggingface.co/SupersonicLabs/Julia-2","images":[{"height":648,"url":"https://pbs.twimg.com/news_img/2124246545117655040/VuCSNXDT?format=jpg&name=orig","width":1200},{"height":150,"url":"https://pbs.twimg.com/news_img/2124246545117655040/VuCSNXDT?format=jpg&name=150x150","width":150}],"start":249,"status":200,"title":"SupersonicLabs/Julia-2 · Hugging Face","unwound_url":"https://huggingface.co/SupersonicLabs/Julia-2","url":"https://t.co/HVkLmBAQER"}]},"id":"2124246520853618909","lang":"en","public_metrics":{"bookmark_count":16,"impression_count":902,"like_count":24,"quote_count":1,"reply_count":1,"retweet_count":1},"referenced_tweets":[{"id":"2124246518550958135","type":"replied_to"}],"text":"You can download Julia 1.5 and Julia 2 on Hugging Face under Apache 2.0. Both releases include weights and runtimes, with setup instructions, evaluation results, and known limitations in the model cards.\n\nJulia 1.5: https://t.co/sI6B47DIQX\nJulia 2: https://t.co/HVkLmBAQER"},{"created_at":"2026-11-21T21:00:11.000Z","edit_history_tweet_ids":["2124246518550958135"],"entities":{"urls":[{"description":"Text Classification model. Download, explore files and run it on Hugging Face.","display_url":"huggingface.co/SupersonicLabs…","end":250,"expanded_url":"https://huggingface.co/SupersonicLabs/Julia-2-Nano","images":[{"height":648,"url":"https://pbs.twimg.com/news_img/2124246536716529664/v6l1Z7hq?format=jpg&name=orig","width":1200},{"height":150,"url":"https://pbs.twimg.com/news_img/2124246536716529664/v6l1Z7hq?format=jpg&name=150x150","width":150}],"start":227,"status":200,"title":"SupersonicLabs/Julia-2-Nano · Hugging Face","unwound_url":"https://huggingface.co/SupersonicLabs/Julia-2-Nano","url":"https://t.co/MKtFDpebNc"},{"display_url":"pic.x.com/6bbfq9QNve","end":274,"expanded_url":"https://x.com/supersonicai/status/2124246518550958135/photo/1","media_key":"3_2124240811076329472","start":251,"url":"https://t.co/6bbfq9QNve"}]},"id":"2124246518550958135","lang":"en","public_metrics":{"bookmark_count":9,"impression_count":1409,"like_count":23,"quote_count":2,"reply_count":1,"retweet_count":0},"referenced_tweets":[{"id":"2124246515275489502","type":"replied_to"}],"text":"For microcontrollers, we built Julia 2 Nano. It packs text decisions, image labels, and spoken intents into 15 MB of weights. It runs in C, with ESP32-S3 firmware for text decisions and fixed label sets for images and speech.\n\nhttps://t.co/MKtFDpebNc https://t.co/6bbfq9QNve"},{"created_at":"2026-11-21T21:00:10.000Z","edit_history_tweet_ids":["2124246515275489502"],"entities":{"urls":[{"description":"Image-Text-to-Text model. Download, explore files and run it on Hugging Face.","display_url":"huggingface.co/SupersonicLabs…","end":267,"expanded_url":"https://huggingface.co/SupersonicLabs/Julia-2-Flash","images":[{"height":648,"url":"https://pbs.twimg.com/news_img/2124246532610494464/HcHih5be?format=jpg&name=orig","width":1200},{"height":150,"url":"https://pbs.twimg.com/news_img/2124246532610494464/HcHih5be?format=jpg&name=150x150","width":150}],"start":244,"status":200,"title":"SupersonicLabs/Julia-2-Flash · Hugging Face","unwound_url":"https://huggingface.co/SupersonicLabs/Julia-2-Flash","url":"https://t.co/eSKR9Lgc98"},{"display_url":"pic.x.com/k7LI9J4yXG","end":291,"expanded_url":"https://x.com/supersonicai/status/2124246515275489502/photo/1","media_key":"3_2124240777408602112","start":268,"url":"https://t.co/k7LI9J4yXG"}]},"id":"2124246515275489502","lang":"en","public_metrics":{"bookmark_count":3,"impression_count":968,"like_count":15,"quote_count":0,"reply_count":1,"retweet_count":0},"referenced_tweets":[{"id":"2124246509843829244","type":"replied_to"}],"text":"We’re also introducing two smaller versions of Julia 2.\n\nJulia 2 Flash keeps the same inputs and API. It takes 658 MB, down from 2.14 GB, and scored within 0.1 points of Julia 2 on our held-out decision test. The text-only weights are 427 MB.\n\nhttps://t.co/eSKR9Lgc98 https://t.co/k7LI9J4yXG"},{"created_at":"2026-11-21T21:00:09.000Z","edit_history_tweet_ids":["2124246509843829244"],"entities":{"urls":[{"display_url":"pic.x.com/PgHqCZz1a2","end":247,"expanded_url":"https://x.com/supersonicai/status/2124246509843829244/photo/1","media_key":"3_2124240689625968640","start":224,"url":"https://t.co/PgHqCZz1a2"}]},"id":"2124246509843829244","lang":"en","public_metrics":{"bookmark_count":3,"impression_count":1025,"like_count":16,"quote_count":0,"reply_count":1,"retweet_count":0},"referenced_tweets":[{"id":"2124246505561395523","type":"replied_to"}],"text":"In early internal testing, Julia 2 reached 77.2% accuracy across 6,000 held-out questions from four business workflows.\n\nOn an NVIDIA RTX PRO 6000, six questions about the same text input took 11.7 ms at the median in BF16. https://t.co/PgHqCZz1a2"},{"created_at":"2026-11-21T21:00:08.000Z","edit_history_tweet_ids":["2124246505561395523"],"entities":{"urls":[{"display_url":"pic.x.com/Mmxg6bPU4r","end":214,"expanded_url":"https://x.com/supersonicai/status/2124246505561395523/photo/1","media_key":"3_2124240654339305473","start":191,"url":"https://t.co/Mmxg6bPU4r"}]},"id":"2124246505561395523","lang":"en","public_metrics":{"bookmark_count":5,"impression_count":1085,"like_count":16,"quote_count":0,"reply_count":1,"retweet_count":0},"referenced_tweets":[{"id":"2124246501819920600","type":"replied_to"}],"text":"The same approach works with live audio. \nAs a support call unfolds, Julia 2 can update which team should handle it and how urgent it is, without reprocessing the audio it has already heard. https://t.co/Mmxg6bPU4r"},{"created_at":"2026-11-21T21:00:07.000Z","edit_history_tweet_ids":["2124246501819920600"],"entities":{"urls":[{"display_url":"pic.x.com/9UyMJJD00r","end":261,"expanded_url":"https://x.com/supersonicai/status/2124246501819920600/video/1","media_key":"13_2124240225853411328","start":238,"url":"https://t.co/9UyMJJD00r"}]},"id":"2124246501819920600","lang":"en","public_metrics":{"bookmark_count":2,"impression_count":1222,"like_count":16,"quote_count":0,"reply_count":1,"retweet_count":0},"referenced_tweets":[{"id":"2124246498024239502","type":"replied_to"}],"text":"Julia 2 extends those decisions beyond text. \nGive it an inspection photo and a part number, and it reads both in one pass. \nIt can then answer two separate questions: is there visible damage, and what kind of defect does the photo show? https://t.co/9UyMJJD00r"},{"created_at":"2026-11-21T21:00:06.000Z","edit_history_tweet_ids":["2124246498024239502"],"entities":{"urls":[{"display_url":"pic.x.com/jMMiF6gPyp","end":202,"expanded_url":"https://x.com/supersonicai/status/2124246498024239502/photo/1","media_key":"3_2124240533350440960","start":179,"url":"https://t.co/jMMiF6gPyp"}]},"id":"2124246498024239502","lang":"en","public_metrics":{"bookmark_count":2,"impression_count":1345,"like_count":21,"quote_count":0,"reply_count":1,"retweet_count":0},"referenced_tweets":[{"id":"2124246493791977780","type":"replied_to"}],"text":"With this release, we’re retiring Julia 1. The Julia 1 API endpoint now routes requests to Julia 1.5 automatically. \nYou can keep using your existing endpoint and request format. https://t.co/jMMiF6gPyp"},{"created_at":"2026-11-21T21:00:05.000Z","edit_history_tweet_ids":["2124246493791977780"],"entities":{"urls":[{"display_url":"pic.x.com/Kd68bxmHDl","end":216,"expanded_url":"https://x.com/supersonicai/status/2124246493791977780/photo/1","media_key":"3_2124240462500212736","start":193,"url":"https://t.co/Kd68bxmHDl"}]},"id":"2124246493791977780","lang":"en","public_metrics":{"bookmark_count":3,"impression_count":1572,"like_count":24,"quote_count":0,"reply_count":1,"retweet_count":0},"referenced_tweets":[{"id":"2124246491371892938","type":"replied_to"}],"text":"On SLCMB, our benchmark for classification models, Julia 1.5 scored 46.2, up from 33.3 for Julia 1.\n\nIn our rule-following tests, Julia 1.5 followed written rules 87% of the time, up from 30%. https://t.co/Kd68bxmHDl"},{"created_at":"2026-11-21T21:00:04.000Z","edit_history_tweet_ids":["2124246491371892938"],"id":"2124246491371892938","lang":"en","public_metrics":{"bookmark_count":2,"impression_count":1784,"like_count":24,"quote_count":0,"reply_count":1,"retweet_count":0},"referenced_tweets":[{"id":"2124246489064993251","type":"replied_to"}],"text":"We created our own Classification Models Benchmark, SLCMB (Supersonic Labs Classification Models Benchmark).\nIt tests how decisions hold up when options move, presenting each of its 920 questions 100 times. We’ll add new tasks as Julia gains capabilities."},{"created_at":"2026-11-21T21:00:04.000Z","edit_history_tweet_ids":["2124246489064993251"],"entities":{"urls":[{"display_url":"pic.x.com/nmmGJul3Fr","end":256,"expanded_url":"https://x.com/supersonicai/status/2124246489064993251/video/1","media_key":"13_2124240202109497344","start":233,"url":"https://t.co/nmmGJul3Fr"}]},"id":"2124246489064993251","lang":"en","public_metrics":{"bookmark_count":5,"impression_count":2473,"like_count":34,"quote_count":0,"reply_count":1,"retweet_count":0},"referenced_tweets":[{"id":"2124246485931876596","type":"replied_to"}],"text":"We built Julia 1.5 for everyday text decisions. It has 144M parameters and returns a probability for each option you give it. \nYour code can use those probabilities to route a ticket, score its urgency, or check it against a policy. https://t.co/nmmGJul3Fr"},{"created_at":"2026-11-21T21:00:03.000Z","edit_history_tweet_ids":["2124246485931876596"],"entities":{"urls":[{"display_url":"pic.x.com/kDTPhxocVM","end":241,"expanded_url":"https://x.com/supersonicai/status/2124246485931876596/video/1","media_key":"13_2124230201953402880","start":218,"url":"https://t.co/kDTPhxocVM"}]},"id":"2124246485931876596","lang":"en","public_metrics":{"bookmark_count":288,"impression_count":37791,"like_count":791,"quote_count":23,"reply_count":25,"retweet_count":152},"text":"Introducing Julia 1.5 and Julia 2: \nTwo models built for decisions in software.\n\nJulia 1.5 follows written rules more reliably at the same size as Julia 1. Julia 2 can make decisions from text, images, and live audio. https://t.co/kDTPhxocVM"},{"created_at":"2026-11-21T20:43:10.000Z","edit_history_tweet_ids":["2124242236460105978"],"id":"2124242236460105978","lang":"en","public_metrics":{"bookmark_count":0,"impression_count":1376,"like_count":28,"quote_count":0,"reply_count":1,"retweet_count":0},"text":"today."},{"created_at":"2026-11-15T20:56:26.000Z","edit_history_tweet_ids":["2122071247496397216"],"id":"2122071247496397216","lang":"en","public_metrics":{"bookmark_count":0,"impression_count":2260,"like_count":34,"quote_count":3,"reply_count":4,"retweet_count":3},"text":"We're about to pull a rabbit out of the hat... 🎩"},{"created_at":"2026-10-04T14:25:50.000Z","edit_history_tweet_ids":["2106752662448603570"],"entities":{"urls":[{"display_url":"x.com/joaoraul/statu…","end":40,"expanded_url":"https://twitter.com/joaoraul/status/2106550964736209327","start":17,"url":"https://t.co/iQ0fI0T4Tj"}]},"id":"2106752662448603570","lang":"en","public_metrics":{"bookmark_count":4,"impression_count":2221,"like_count":19,"quote_count":0,"reply_count":2,"retweet_count":2},"referenced_tweets":[{"id":"2106550964736209327","type":"quoted"}],"text":"This is so cool! https://t.co/iQ0fI0T4Tj"},{"created_at":"2026-10-02T19:00:12.000Z","edit_history_tweet_ids":["2106096932938756175"],"entities":{"urls":[{"display_url":"console.supersoniclabs.ai","end":277,"expanded_url":"https://console.supersoniclabs.ai/","start":254,"status":200,"unwound_url":"https://console.supersoniclabs.ai/login","url":"https://t.co/x3XJoATGHN"},{"display_url":"pic.x.com/KjMtKJqjjs","end":301,"expanded_url":"https://x.com/supersonicai/status/2106096932938756175/photo/1","media_key":"3_2106095958249398272","start":278,"url":"https://t.co/KjMtKJqjjs"}]},"id":"2106096932938756175","lang":"en","public_metrics":{"bookmark_count":29,"impression_count":7424,"like_count":126,"quote_count":6,"reply_count":5,"retweet_count":14},"text":"The moment you all been waiting for!\n\nour API is officially live! 🚀\n\nYou can now get early access to Julia-1 and be among the first to try our future models as they launch.\n\nWe’re also giving free credits to our first users 👀\n\nJoin the closed beta now:\n\nhttps://t.co/x3XJoATGHN https://t.co/KjMtKJqjjs"},{"created_at":"2026-09-30T23:29:24.000Z","edit_history_tweet_ids":["2105439829907677247","2105439902452297887"],"entities":{"urls":[{"display_url":"pic.x.com/1BkNJfP2Zo","end":25,"expanded_url":"https://x.com/supersonicai/status/2105439902452297887/photo/1","media_key":"3_2105439820487045120","start":2,"url":"https://t.co/1BkNJfP2Zo"}]},"id":"2105439902452297887","lang":"qme","public_metrics":{"bookmark_count":3,"impression_count":2443,"like_count":33,"quote_count":1,"reply_count":2,"retweet_count":1},"text":"👀 https://t.co/1BkNJfP2Zo"},{"created_at":"2026-09-29T00:43:19.000Z","edit_history_tweet_ids":["2104733726362009971"],"entities":{"urls":[{"display_url":"x.com/joaoraul/statu…","end":55,"expanded_url":"https://twitter.com/joaoraul/status/2104727296313827556","start":32,"url":"https://t.co/xClL25J1Uf"}]},"id":"2104733726362009971","lang":"en","public_metrics":{"bookmark_count":24,"impression_count":7552,"like_count":140,"quote_count":0,"reply_count":4,"retweet_count":5},"referenced_tweets":[{"id":"2104727296313827556","type":"quoted"}],"text":"Oh... They grow up so fast... 🥺 https://t.co/xClL25J1Uf"}],"meta":{"newest_id":"2124246526499361067","next_token":"7140dibdnow9c7btwp0fs0eh9tt3mz4nop70reyp0hnw1","oldest_id":"2104733726362009971","result_count":19}}