"},{"description":"Run Cline with local models using Ollama, LM Studio or Atomic Chat.","display_url":"docs.cline.bot/running-models…","end":169,"expanded_url":"https://docs.cline.bot/running-models-locally/overview","images":[{"height":630,"url":"https://pbs.twimg.com/news_img/2112967142291480577/nB6N19f6?format=jpg&name=orig","width":1200},{"height":150,"url":"https://pbs.twimg.com/news_img/2112967142291480577/nB6N19f6?format=jpg&name=150x150","width":150}],"start":146,"status":200,"title":"Local models - Cline","unwound_url":"https://docs.cline.bot/running-models-locally/overview","url":"https://t.co/lmNtVt52GX"},{"description":"Text Generation model with 40B parameters. Download, explore files and run it on Hugging Face.","display_url":"huggingface.co/RecursiveSI/fl…","end":212,"expanded_url":"https://huggingface.co/RecursiveSI/flint","images":[{"height":648,"url":"https://pbs.twimg.com/news_img/2123523847928389633/p3dVUn4t?format=jpg&name=orig","width":1200},{"height":150,"url":"https://pbs.twimg.com/news_img/2123523847928389633/p3dVUn4t?format=jpg&name=150x150","width":150}],"start":189,"status":200,"title":"RecursiveSI/flint · Hugging Face","unwound_url":"https://huggingface.co/RecursiveSI/flint","url":"https://t.co/Sxz2cjp1Sh"}]},"id":"2112967125715529847","lang":"en","public_metrics":{"bookmark_count":3,"impression_count":3701,"like_count":13,"quote_count":0,"reply_count":1,"retweet_count":0},"referenced_tweets":[{"id":"2112967124360802531","type":"replied_to"}],"text":"Run it in Cline now:\n\n1) Install Cline:\nnpm i -g cline\nOr use our desktop app:\nhttps://t.co/aex0iORZQj\n\n2) Configure local models through Ollama:\nhttps://t.co/lmNtVt52GX\n\n3) Install Flint:\nhttps://t.co/Sxz2cjp1Sh"},{"created_at":"2026-10-21T17:59:54.000Z","edit_history_tweet_ids":["2112967124360802531"],"entities":{"urls":[{"display_url":"pic.x.com/9QQFQjgtN4","end":298,"expanded_url":"https://x.com/cline/status/2112967124360802531/photo/1","media_key":"3_2112966383554408450","sta