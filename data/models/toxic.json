    {
      "language": "swift",
      "code": "import Toxic\n\nlet toxic = Toxic()\nlet result = try await toxic.analyze(comment)\nif result.isToxic { holdForReview(result.content, result.targets) }\nresult.score(.hateful)     // 0...1\nresult.flagged             // the heads at or above their thresholds"
