{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "democratic-ai",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "main": "worker.js",
  "routes": [
    {
      "pattern": "democratic-ai.bevry.me",
      "custom_domain": true
    },
    {
      "pattern": "democraticai.bevry.me",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
