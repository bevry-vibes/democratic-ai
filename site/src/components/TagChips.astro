---
import { sortTags, tagDefinition, tagLabel, tagPath, tagStatus } from "../lib/data"

interface Props {
  tags: string[]
  limit?: number
  showNamespace?: boolean
  links?: boolean
  class?: string
}

const { tags, limit, showNamespace = false, links = true, class: className = "" } = Astro.props
const ordered = sortTags(tags)
const visible = limit ? ordered.slice(0, limit) : ordered
const label = (tag: string) => (showNamespace ? tag : tagLabel(tag))
const kind = (tag: string) => `chip ${tagStatus(tag)}`
---

<div class={`flex wrap-gap ${className}`.trim()}>
  {visible.map((tag) => {
    const explanation = tagDefinition(tag)
    return links ? (
      <a class={kind(tag)} href={tagPath(tag)} data-tooltip={explanation} aria-label={`${tag}: ${explanation}`}>
        {label(tag)}
      </a>
    ) : (
      <span class={kind(tag)} data-tooltip={explanation} tabindex="0" aria-label={`${tag}: ${explanation}`}>
        {label(tag)}
      </span>
    )
  })}
  <slot />
</div>
