---
interface PillLink {
  label: string
  href: string
  external?: boolean
}

interface Props {
  label: string
  explanation: string
  href: string
  tone?: string
  missing?: boolean
  website?: { label: string; href: string }
  links?: PillLink[]
}

const { label, explanation, href, tone = "", missing = false, website, links = [] } = Astro.props
---

<li class:list={["pill-row", { "pill-row-missing": missing }]}>
  <a
    class:list={["chip", tone, { "pill-missing": missing }]}
    href={href}
    data-tooltip={explanation}
    aria-label={`${label}. ${explanation}`}
  >{label}</a>
  <div class="pill-explain">
    <p
      class:list={{ "pill-missing-text": missing }}
      data-tooltip={missing ? "Not available for this model." : undefined}
      tabindex={missing ? "0" : undefined}
    >{explanation}</p>
    {website && (
      <a class="pill-website" href={website.href} target="_blank" rel="noreferrer">↗ {website.label}</a>
    )}
    {links.length > 0 && (
      <ul class="pill-links">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer" : undefined}
            >↗ {link.label}</a>
          </li>
        ))}
      </ul>
    )}
  </div>
</li>
