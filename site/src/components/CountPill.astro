---
interface Props {
  label: string
  count: string | number
  href: string
  tone?: string
  tooltip?: string
  class?: string
}

const { label, count, href, tone = "sage", tooltip, class: className = "" } = Astro.props
---

<a
  class={`count-pill ${tone} ${className}`.trim()}
  href={href}
  data-tooltip={tooltip}
  aria-label={tooltip ? `${label}: ${count}. ${tooltip}` : `${label}: ${count}`}
>
  <span class="count-pill-label">{label}</span>
  <span class="count-pill-count">{count}</span>
</a>
