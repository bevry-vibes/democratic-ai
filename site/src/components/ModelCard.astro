---
import type { CompactModel } from "../lib/data"
import { formatContextCount, modelHref, tagDefinition, tagLabel, tagPath } from "../lib/data"
import CountPill from "./CountPill.astro"

interface Props {
  model: CompactModel
}

const { model } = Astro.props
const task = model.tasks[0] ?? null
const onDevice = model.tags.includes("context:on-device")
---

<div class="card model-card">
  <div class="model-card-top">
    <div>
      <a class="row-title" href={modelHref(model.id)}><h3>{model.name}</h3></a>
      <p class="faint mono-small mb-0">{model.organization}</p>
    </div>
    <div class="card-score">
      <CountPill
        label="syndication"
        count={`${model.score}/10`}
        href={`${modelHref(model.id)}#scorecard`}
        tone="plum"
        tooltip="Independent listings, not quality. The model's own host has weight 0."
      />
    </div>
  </div>
  {model.summary && <p class="summary">{model.summary}</p>}
  <div class="meta">
    {task && (
      <a class="chip task" href={tagPath(`task:${task}`)} data-tooltip={tagDefinition(`task:${task}`)}>
        {tagLabel(`task:${task}`)}
      </a>
    )}
    {onDevice && (
      <a class="chip context" href={tagPath("context:on-device")} data-tooltip={tagDefinition("context:on-device")}>
        on-device
      </a>
    )}
    {model.context_tokens && (
      <CountPill
        label="context"
        count={formatContextCount(model.context_tokens)}
        href={`${modelHref(model.id)}#capabilities`}
        tone="sky"
        tooltip="The model's maximum context window."
      />
    )}
    {model.builds > 0 && (
      <CountPill
        label="builds"
        count={model.builds}
        href={`${modelHref(model.id)}#builds`}
        tone="plum"
        tooltip="A build is packaging, not a new model. It inherits the base task and terms."
      />
    )}
    <a class="chip license" href={tagPath(`license:${model.license}`)} data-tooltip={tagDefinition(`license:${model.license}`)}>
      {model.license}
    </a>
  </div>
</div>
