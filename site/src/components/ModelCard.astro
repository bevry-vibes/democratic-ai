---
import type { CompactModel } from "../lib/data"
import { formatContext, modelHref, tagDefinition, tagLabel, tagPath } from "../lib/data"
import ScoreBadge from "./ScoreBadge.astro"

interface Props {
  model: CompactModel
}

const { model } = Astro.props
const task = model.tasks[0] ?? null
const onDevice = model.tags.includes("context:on-device")
---

<div class="card model-card">
  <div class="model-card-top">
    <div>
      <a class="row-title" href={modelHref(model.id)}><h3>{model.name}</h3></a>
      <p class="faint mono-small mb-0">{model.organization}</p>
    </div>
    <div class="card-score">
      <span class="score-prefix">syndication:</span>
      <ScoreBadge score={model.score} band={model.band} />
    </div>
  </div>
  {model.summary && <p class="summary">{model.summary}</p>}
  <div class="meta">
    {task && (
      <a class="chip task" href={tagPath(`task:${task}`)} title={tagDefinition(`task:${task}`)}>
        {tagLabel(`task:${task}`)}
      </a>
    )}
    {onDevice && (
      <a class="chip context" href={tagPath("context:on-device")} title={tagDefinition("context:on-device")}>
        on-device
      </a>
    )}
    {model.context_tokens && <span class="chip">{formatContext(model.context_tokens)}</span>}
    {model.builds > 0 && <span class="chip">{model.builds} {model.builds === 1 ? "build" : "builds"}</span>}
    <a class="chip license" href={tagPath(`license:${model.license}`)} title={tagDefinition(`license:${model.license}`)}>
      {model.license}
    </a>
  </div>
</div>
