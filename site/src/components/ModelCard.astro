---
import type { CompactModel } from "../lib/data"
import { formatContextCount, modelHref, tagDefinition, tagLabel, tagPath } from "../lib/data"
import CountPill from "./CountPill.astro"

interface Props {
  model: CompactModel
}

const { model } = Astro.props
const task = model.tasks[0] ?? null
const onDevice = model.tags.includes("context:on-device")
---

<div class="card model-card">
  <div class="model-card-top">
    <div>
      <a class="row-title" href={modelHref(model.id)}><h3>{model.name}</h3></a>
      <p class="faint mono-small mb-0">{model.organization}</p>
    </div>
    <div class="card-score">
      <CountPill
        label="overall"
        count={model.scorecard?.overall.score == null ? "—" : Math.round(model.scorecard.overall.score)}
        href={`${modelHref(model.id)}#scorecard-overall`}
        tone="score-overall"
        tooltip={
          model.scorecard?.overall.score == null
            ? "No overall score is available."
            : `Weighted mean of ${model.scorecard.overall.coverage} of 4 axes: openness, performance, research, and syndication. Missing axes are excluded, not zero.`
        }
      />
    </div>
  </div>
  {model.summary && <p class="summary">{model.summary}</p>}
  <div class="meta">
    {model.scorecard?.overall.coverage != null && (
      <CountPill
        label="coverage"
        count={`${model.scorecard.overall.coverage}/4`}
        href={`${modelHref(model.id)}#scorecard-overall`}
        tone="score-coverage"
        tooltip="How many scorecard axes have a current value. A missing axis is not zero."
      />
    )}
    {task && (
      <a class="chip tag-task" href={tagPath(`task:${task}`)} data-tooltip={tagDefinition(`task:${task}`)}>
        task: {tagLabel(`task:${task}`)}
      </a>
    )}
    {onDevice && (
      <a class="chip tag-context" href={tagPath("context:on-device")} data-tooltip={tagDefinition("context:on-device")}>
        context: on-device
      </a>
    )}
    {model.context_tokens && (
      <a
        class="chip meta-context"
        href={`${modelHref(model.id)}#capabilities`}
        data-tooltip="The model's maximum context window."
      >
        context: {formatContextCount(model.context_tokens)}
      </a>
    )}
    {model.builds > 0 && (
      <CountPill
        label="builds"
        count={model.builds}
        href={`${modelHref(model.id)}#builds`}
        tone="meta-builds"
        tooltip="A build is packaging, not a new model. It inherits the base task and terms."
      />
    )}
    <a class="chip tag-license" href={tagPath(`license:${model.license}`)} data-tooltip={tagDefinition(`license:${model.license}`)}>
      license: {model.license}
    </a>
  </div>
</div>
