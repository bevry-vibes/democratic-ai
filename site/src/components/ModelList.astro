---
import CountPill from "./CountPill.astro"
import Pill from "./Pill.astro"
import TagChips from "./TagChips.astro"
import { formatContextCount, modelHref, scorecardAxes, type CompactModel } from "../lib/data"

interface Props {
  models: CompactModel[]
  listId?: string
  listCols?: string
  lazyFrom?: number | null
}

const {
  models,
  listId = "model-list",
  listCols = "minmax(12rem, 0.9fr) minmax(18rem, 2.2fr) minmax(10.5rem, auto)",
  lazyFrom = null,
} = Astro.props

const axis = (model: CompactModel, key: "openness" | "performance" | "research" | "syndication") =>
  scorecardAxes(model).find((entry) => entry.key === key)?.value ?? null
const scorecardTone = (key: string) => `score-${key}`
const scorecardTip = (key: string) =>
  key === "overall"
    ? "Overall score: weighted mean of the available axes. Missing axes are excluded, not zero."
    : key === "openness"
    ? "Openness/Morality: what the release gives back. Computed from current release terms."
    : key === "performance"
      ? "Performance/Intelligence: current measured performance on the model's task."
      : key === "research"
        ? "Citation/Research: current research benchmarks. Citation accuracy is separate."
        : "Syndication: independent listings, not quality."
---

<div class="list" id={listId} style={`--list-cols:${listCols}`}>
  {models.map((model, index) => {
    const axes = scorecardAxes(model)
    return (
      <div
        class:list={["list-row", { "lazy-row": lazyFrom != null && index >= lazyFrom }]}
        data-name={`${model.name} ${model.organization} ${model.summary}`.toLowerCase()}
        data-tags={model.tags.join(" ")}
        data-capability={[
          model.tool_calling ? "tool-calling" : "",
          model.reasoning ? "reasoning" : "",
          model.structured_output ? "structured-output" : "",
        ].filter(Boolean).join(" ")}
        data-contexts={model.tags.filter((tag) => tag.startsWith("context:")).map((tag) => tag.slice(8)).join(" ")}
        data-context-tokens={model.context_tokens ?? ""}
        data-params={model.params_b ?? ""}
        data-tier={model.tier}
        data-band={model.band}
        data-license={model.license}
        data-access={[
          "huggingface",
          model.models_dev ? "models.dev" : "",
          model.agent_detect ? "agent-detect" : "",
          model.providers.includes("opencode") || model.providers.includes("opencode-go") ? "opencode" : "",
          model.providers.includes("cloudflare-workers-ai") ? "cloudflare" : "",
          model.providers.includes("openrouter") ? "openrouter" : "",
        ].filter(Boolean).join(" ")}
        data-weights={model.weights === "open-weight" ? "open" : model.weights}
        data-training-data={model.training_data}
        data-training-code={model.training_code}
        data-builds={model.builds}
        data-org={model.organization}
        data-overall={model.scorecard?.overall.score ?? -1}
        data-openness={axis(model, "openness") ?? -1}
        data-performance={axis(model, "performance") ?? -1}
        data-research={axis(model, "research") ?? -1}
        data-score={axis(model, "syndication") ?? 0}
        data-released={model.released ?? ""}
      >
        <div>
          <a class="row-title" href={modelHref(model.id)}><h3>{model.name}</h3></a>
          <p class="mono-small">{model.organization}</p>
        </div>
        <div class="list-description">
          <p>{model.summary || "No description on the model card."}</p>
          <TagChips tags={model.tags} showNamespace>
            {model.context_tokens && (
              <Pill
                label={`context:${formatContextCount(model.context_tokens)}`}
                href={`${modelHref(model.id)}#capabilities`}
                tone="tag-capability"
                tooltip="The model's maximum context window."
              />
            )}
            {model.builds > 0 && (
              <Pill
                label={`builds:${model.builds}`}
                href={`${modelHref(model.id)}#builds`}
                tone="tag-release"
                tooltip="A build is packaging, not a new model. It inherits the base task and terms."
              />
            )}
          </TagChips>
        </div>
        <div class="scorecard-mini">
          {axes.map((entry) => (
            <CountPill
              label={entry.label}
              count={entry.display}
              href={`${modelHref(model.id)}#scorecard-${entry.key}`}
              tone={scorecardTone(entry.key)}
              tooltip={scorecardTip(entry.key)}
            />
          ))}
        </div>
      </div>
    )
  })}
</div>
