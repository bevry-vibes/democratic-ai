---
import Base from "../../layouts/Base.astro"
import ModelList from "../../components/ModelList.astro"
import { getIndex, sortTags } from "../../lib/data"

const index = getIndex()
const models = [...index.models].sort(
  (a, b) => (b.scorecard?.overall.score ?? -1) - (a.scorecard?.overall.score ?? -1) || a.name.localeCompare(b.name),
)
const allTags = sortTags([...new Set(models.flatMap((model) => model.tags))])
---

<Base
  title="Models"
  description={`Browse ${models.length} democratic AI models by task, context, licence, and current scorecard.`}
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">The index</p>
      <h1>Models</h1>
      <p class="lede">
        {models.length} root and notable models. Builds attach to their base model and do not appear as separate
        entries. The scorecard is independent of the release tier.
      </p>
      <p class="hero-meta"><a href="/models/feed.xml">Model feed</a> · newest release first</p>
    </div>
  </section>

  <section class="wrap" style="padding-top:1.5rem">
    <div class="filters" style="--filter-cols:minmax(12rem,1.2fr) repeat(2,minmax(8rem,0.7fr)) minmax(18rem,1.6fr)">
      <div class="field">
        <label for="q">Search</label>
        <input id="q" type="search" placeholder="Name, organisation, or summary" autocomplete="off" />
      </div>
      <div class="field">
        <label>Filter <span class="field-hint">all required</span></label>
        <details class="combo" id="filter-combo">
          <summary><span id="filter-summary">All tags</span></summary>
          <div class="combo-panel">
            {allTags.map((available) => (
              <label class="combo-option">
                <input type="checkbox" name="filter" value={available} />
                <span>{available}</span>
              </label>
            ))}
          </div>
        </details>
      </div>
      <div class="field">
        <label>Options <span class="field-hint">any required</span></label>
        <details class="combo" id="options-combo">
          <summary><span id="options-summary">Any tag</span></summary>
          <div class="combo-panel">
            {allTags.map((available) => (
              <label class="combo-option">
                <input type="checkbox" name="options" value={available} />
                <span>{available}</span>
              </label>
            ))}
          </div>
        </details>
      </div>
      <div class="field">
        <label for="sort">Sort</label>
        <div class="sort-control">
          <select id="sort">
            <option value="overall">Overall score</option>
            <option value="syndication">Syndication</option>
            <option value="performance">Performance/Intelligence</option>
            <option value="openness">Openness/Morality</option>
            <option value="research">Citation/Research</option>
            <option value="released">Release date</option>
            <option value="name">Name</option>
          </select>
          <button id="order" class="order-toggle" type="button" aria-label="Reverse the sort order">
            High first
          </button>
        </div>
      </div>
    </div>

    <div class="filter-meta">
      <span id="count">Showing {models.length} models</span>
      <span class="faint" id="sort-note">Sorted by independent listings, best first</span>
    </div>

    <ModelList models={models} />

    <div class="empty hidden" id="empty">
      No model matches those filters. Try a broader task or clear the search.
    </div>

    <noscript>
      <p class="muted mt-2">The filters and sorting need JavaScript. Every model is listed below without it.</p>
    </noscript>
  </section>

  <script>
    const q = document.getElementById("q") as HTMLInputElement | null
    const filterCombo = document.getElementById("filter-combo")
    const optionsCombo = document.getElementById("options-combo")
    const filterSummary = document.getElementById("filter-summary")
    const optionsSummary = document.getElementById("options-summary")
    const filterChecks = [...document.querySelectorAll<HTMLInputElement>("#filter-combo input[type=checkbox]")]
    const optionChecks = [...document.querySelectorAll<HTMLInputElement>("#options-combo input[type=checkbox]")]
    const sort = document.getElementById("sort") as HTMLSelectElement | null
    const order = document.getElementById("order")
    const count = document.getElementById("count")
    const note = document.getElementById("sort-note")
    const empty = document.getElementById("empty")
    const list = document.getElementById("model-list")
    const rows = [...document.querySelectorAll<HTMLElement>("#model-list .list-row")]

    const params = new URLSearchParams(location.search)
    let orderMode = params.get("order") === "worst" ? "worst" : "best"
    if (q && params.get("q")) q.value = params.get("q")!
    if (sort && params.get("sort")) sort.value = params.get("sort")!
    for (const box of filterChecks) box.checked = (params.get("filter") ?? "").split(",").filter(Boolean).includes(box.value)
    for (const box of optionChecks) box.checked = (params.get("options") ?? "").split(",").filter(Boolean).includes(box.value)

    function selected(boxes: HTMLInputElement[]): string[] {
      return boxes.filter((box) => box.checked).map((box) => box.value)
    }

    function updateSummaries(): void {
      const filterCount = selected(filterChecks).length
      const optionCount = selected(optionChecks).length
      if (filterSummary) filterSummary.textContent = filterCount ? `${filterCount} selected` : "All tags"
      if (optionsSummary) optionsSummary.textContent = optionCount ? `${optionCount} selected` : "Any tag"
    }

    function setOrderLabel(): void {
      if (!order) return
      const mode = sort?.value ?? "overall"
      if (mode === "name") order.textContent = orderMode === "best" ? "A–Z" : "Z–A"
      else if (mode === "released") order.textContent = orderMode === "best" ? "Newest" : "Oldest"
      else order.textContent = orderMode === "best" ? "High first" : "Low first"
    }

    function number(row: HTMLElement, key: string): number | null {
      const raw = row.dataset[key]
      if (!raw) return null
      const value = Number(raw)
      return Number.isFinite(value) && value >= 0 ? value : null
    }

    function compare(a: HTMLElement, b: HTMLElement, key: string): number {
      const av = number(a, key)
      const bv = number(b, key)
      if (av == null && bv == null) return 0
      if (av == null) return 1
      if (bv == null) return -1
      if (av === bv) return 0
      const best = -1 * (av - bv)
      return orderMode === "best" ? best : -best
    }

    function apply(): void {
      const search = q?.value.trim().toLowerCase() ?? ""
      const required = selected(filterChecks)
      const optional = selected(optionChecks)
      const capabilityValue = params.get("capability") ?? ""
      const bandValue = params.get("band") ?? ""
      const tierValue = params.get("tier") ?? ""
      const accessValue = params.get("access") ?? ""
      const weightsValue = params.get("weights") ?? ""
      const trainingDataValue = params.get("training_data") ?? ""
      const trainingCodeValue = params.get("training_code") ?? ""
      const licenseValue = params.get("license") ?? ""
      const minContext = Number(params.get("min_context") ?? 0)
      const minParams = Number(params.get("min_params") ?? 0)
      const minSizeGb = Number(params.get("min_size_gb") ?? 0)
      const minBuilds = Number(params.get("min_builds") ?? 0)
      let visible = 0
      for (const row of rows) {
        const tags = row.dataset.tags?.split(" ") ?? []
        const contextTokens = Number(row.dataset.contextTokens || 0)
        const paramsB = Number(row.dataset.params || 0)
        const sizeGb = Number(row.dataset.sizeGb || 0)
        const matches =
          (!search || row.dataset.name?.includes(search)) &&
          (required.length === 0 || required.every((value) => tags.includes(value))) &&
          (optional.length === 0 || optional.some((value) => tags.includes(value))) &&
          (!capabilityValue || row.dataset.capability?.split(" ").includes(capabilityValue)) &&
          (!bandValue || row.dataset.band === bandValue) &&
          (!tierValue || row.dataset.tier === tierValue) &&
          (!accessValue || row.dataset.access?.split(" ").includes(accessValue)) &&
          (!weightsValue || row.dataset.weights === weightsValue) &&
          (!trainingDataValue || row.dataset.trainingData === trainingDataValue) &&
          (!trainingCodeValue || row.dataset.trainingCode === trainingCodeValue) &&
          (!licenseValue || row.dataset.license === licenseValue) &&
          (!minContext || contextTokens >= minContext) &&
          (!minParams || paramsB >= minParams) &&
          (!minSizeGb || sizeGb >= minSizeGb) &&
          (!minBuilds || Number(row.dataset.builds || 0) >= minBuilds)
        row.classList.toggle("hidden", !matches)
        if (matches) visible++
      }
      if (count) count.textContent = `Showing ${visible} of ${rows.length} models`
      empty?.classList.toggle("hidden", visible > 0)
      updateSummaries()

      const mode = sort?.value ?? "overall"
      setOrderLabel()
      const sorted = [...rows].sort((a, b) => {
        if (mode === "name") {
          const diff = (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "")
          return orderMode === "best" ? diff : -diff
        }
        if (mode === "released") {
          const av = a.dataset.released ?? ""
          const bv = b.dataset.released ?? ""
          if (!av && !bv) return 0
          if (!av) return 1
          if (!bv) return -1
          const diff = av.localeCompare(bv)
          return orderMode === "best" ? -diff : diff
        }
        const key =
          mode === "overall"
            ? "overall"
            : mode === "openness"
              ? "openness"
              : mode === "performance"
                ? "performance"
                : mode === "research"
                  ? "research"
                  : "score"
        return compare(a, b, key) || (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "")
      })
      for (const row of sorted) list?.append(row)

      if (note) {
        const labels: Record<string, string> = {
          overall: "overall score",
          syndication: "independent listings",
          performance: "Performance/Intelligence",
          openness: "Openness/Morality",
          research: "Citation/Research",
          released: "release date",
          name: "name",
        }
        const label = labels[mode] ?? mode
        const direction =
          mode === "name"
            ? orderMode === "best"
              ? "A–Z"
              : "Z–A"
            : mode === "released"
              ? orderMode === "best"
                ? "newest first"
                : "oldest first"
              : orderMode === "best"
                ? "high first"
                : "low first"
        note.textContent = `Sorted by ${label}, ${direction}. Missing scores sort last.`
      }

      const next = new URLSearchParams()
      if (search) next.set("q", search)
      if (required.length > 0) next.set("filter", required.join(","))
      if (optional.length > 0) next.set("options", optional.join(","))
      if (capabilityValue) next.set("capability", capabilityValue)
      if (bandValue) next.set("band", bandValue)
      if (tierValue) next.set("tier", tierValue)
      if (accessValue) next.set("access", accessValue)
      if (weightsValue) next.set("weights", weightsValue)
      if (trainingDataValue) next.set("training_data", trainingDataValue)
      if (trainingCodeValue) next.set("training_code", trainingCodeValue)
      if (licenseValue) next.set("license", licenseValue)
      if (minContext) next.set("min_context", String(minContext))
      if (minParams) next.set("min_params", String(minParams))
      if (minSizeGb) next.set("min_size_gb", String(minSizeGb))
      if (minBuilds) next.set("min_builds", String(minBuilds))
      if (mode !== "overall") next.set("sort", mode)
      if (orderMode !== "best") next.set("order", orderMode)
      const query = next.toString()
      history.replaceState(null, "", query ? `?${query}` : location.pathname)
    }

    q?.addEventListener("input", apply)
    for (const box of [...filterChecks, ...optionChecks]) box.addEventListener("change", apply)
    sort?.addEventListener("input", apply)
    order?.addEventListener("click", () => {
      orderMode = orderMode === "best" ? "worst" : "best"
      apply()
    })
    document.addEventListener("click", (event) => {
      for (const combo of [filterCombo, optionsCombo]) {
        if (combo && !combo.contains(event.target as Node)) combo.removeAttribute("open")
      }
    })
    apply()
  </script>
</Base>
