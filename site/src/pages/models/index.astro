---
import Base from "../../layouts/Base.astro"
import CountPill from "../../components/CountPill.astro"
import TagChips from "../../components/TagChips.astro"
import { formatContextCount, getIndex, modelHref, scorecardAxes } from "../../lib/data"

const index = getIndex()
const models = [...index.models].sort((a, b) => b.score - a.score || a.name.localeCompare(b.name))
const tasks = [...new Set(models.flatMap((model) => model.tasks))].sort()
const contexts = [...new Set(models.flatMap((model) => model.tags.filter((tag) => tag.startsWith("context:"))))]
  .map((tag) => tag.slice("context:".length))
  .sort()
const bands = ["very-strong", "strong", "moderate", "emerging", "weak", "self-only"]
const defaultSort = "syndication"
const axis = (model: (typeof models)[number], key: "openness" | "performance" | "research" | "syndication") =>
  scorecardAxes(model).find((entry) => entry.key === key)?.value ?? null
const scorecardTone = (key: string) => `score-${key}`
const scorecardTip = (key: string) =>
  key === "openness"
    ? "Openness/Morality: what the release gives back. Computed from current release terms."
    : key === "performance"
      ? "Performance/Intelligence: current measured performance on the model's task."
      : key === "research"
        ? "Research/Citation: current research benchmarks. Citation accuracy is separate."
        : "Syndication: independent listings, not quality."
---

<Base
  title="Models"
  description={`Browse ${models.length} democratic AI models by task, context, licence, and current scorecard.`}
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">The index</p>
      <h1>Models</h1>
      <p class="lede">
        {models.length} root and notable models. Builds attach to their base model and do not appear as separate
        entries. The scorecard is independent of the release tier.
      </p>
    </div>
  </section>

  <section class="wrap" style="padding-top:1.5rem">
    <div class="filters" style="--filter-cols:minmax(12rem,1.4fr) repeat(3,minmax(8rem,0.7fr)) minmax(15rem,1.2fr)">
      <div class="field">
        <label for="q">Search</label>
        <input id="q" type="search" placeholder="Name, organisation, or summary" autocomplete="off" />
      </div>
      <div class="field">
        <label for="task">Task</label>
        <select id="task">
          <option value="">All tasks</option>
          {tasks.map((task) => <option value={task}>{task.replaceAll("-", " ")}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="context">Context</label>
        <select id="context">
          <option value="">All contexts</option>
          {contexts.map((context) => <option value={context}>{context.replaceAll("-", " ")}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="band">Syndication</label>
        <select id="band">
          <option value="">All bands</option>
          {bands.map((band) => <option value={band}>{band.replaceAll("-", " ")}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="sort">Sort</label>
        <div class="sort-control">
          <select id="sort">
            <option value="overall">Overall score</option>
            <option value="syndication">Syndication</option>
            <option value="performance">Performance/Intelligence</option>
            <option value="openness">Openness/Morality</option>
            <option value="research">Research/Citation</option>
            <option value="released">Release date</option>
            <option value="name">Name</option>
          </select>
          <button id="order" class="order-toggle" type="button" aria-label="Reverse the sort order">
            High first
          </button>
        </div>
      </div>
    </div>

    <div class="filter-meta">
      <span id="count">Showing {models.length} models</span>
      <span class="faint" id="sort-note">Sorted by independent listings, best first</span>
    </div>

    <div class="list" id="model-list" style="--list-cols:minmax(12rem, 0.9fr) minmax(18rem, 2.2fr) minmax(10.5rem, auto)">
      {models.map((model) => {
        const axes = scorecardAxes(model)
        return (
          <div
            class="list-row"
            data-name={`${model.name} ${model.organization} ${model.summary}`.toLowerCase()}
            data-tasks={model.tasks.join(" ")}
            data-contexts={model.tags.filter((tag) => tag.startsWith("context:")).map((tag) => tag.slice(8)).join(" ")}
            data-band={model.band}
            data-license={model.license}
            data-overall={model.scorecard?.overall.score ?? -1}
            data-openness={axis(model, "openness") ?? -1}
            data-performance={axis(model, "performance") ?? -1}
            data-research={axis(model, "research") ?? -1}
            data-score={axis(model, "syndication") ?? 0}
            data-released={model.released ?? ""}
          >
            <div>
              <a class="row-title" href={modelHref(model.id)}><h3>{model.name}</h3></a>
              <p class="mono-small">{model.organization}</p>
            </div>
            <div class="list-description">
              <p>{model.summary || "No description on the model card."}</p>
              <TagChips tags={model.tags} showNamespace>
                {model.context_tokens && (
                  <a
                    class="chip meta-context"
                    href={`${modelHref(model.id)}#capabilities`}
                    data-tooltip="The model's maximum context window."
                  >
                    context: {formatContextCount(model.context_tokens)}
                  </a>
                )}
                {model.builds > 0 && (
                  <CountPill
                    label="builds"
                    count={model.builds}
                    href={`${modelHref(model.id)}#builds`}
                    tone="meta-builds"
                    tooltip="A build is packaging, not a new model. It inherits the base task and terms."
                  />
                )}
              </TagChips>
            </div>
            <div class="scorecard-mini">
              {axes.map((entry) => (
                <CountPill
                  label={entry.label}
                  count={entry.display}
                  href={`${modelHref(model.id)}#scorecard-${entry.key}`}
                  tone={scorecardTone(entry.key)}
                  tooltip={scorecardTip(entry.key)}
                />
              ))}
            </div>
          </div>
        )
      })}
    </div>

    <div class="empty hidden" id="empty">
      No model matches those filters. Try a broader task or clear the search.
    </div>

    <noscript>
      <p class="muted mt-2">The filters and sorting need JavaScript. Every model is listed below without it.</p>
    </noscript>
  </section>

  <script>
    const q = document.getElementById("q") as HTMLInputElement | null
    const task = document.getElementById("task") as HTMLSelectElement | null
    const context = document.getElementById("context") as HTMLSelectElement | null
    const band = document.getElementById("band") as HTMLSelectElement | null
    const sort = document.getElementById("sort") as HTMLSelectElement | null
    const order = document.getElementById("order")
    const count = document.getElementById("count")
    const note = document.getElementById("sort-note")
    const empty = document.getElementById("empty")
    const list = document.getElementById("model-list")
    const rows = [...document.querySelectorAll<HTMLElement>("#model-list .list-row")]

    const params = new URLSearchParams(location.search)
    let orderMode = params.get("order") === "worst" ? "worst" : "best"
    if (q && params.get("q")) q.value = params.get("q")!
    if (task && params.get("task")) task.value = params.get("task")!
    if (context && params.get("context")) context.value = params.get("context")!
    if (band && params.get("band")) band.value = params.get("band")!
    if (sort && params.get("sort")) sort.value = params.get("sort")!

    function setOrderLabel() {
      if (!order) return
      const mode = sort?.value ?? "syndication"
      if (mode === "name") order.textContent = orderMode === "best" ? "A–Z" : "Z–A"
      else if (mode === "released") order.textContent = orderMode === "best" ? "Newest" : "Oldest"
      else order.textContent = orderMode === "best" ? "High first" : "Low first"
    }

    function number(row: HTMLElement, key: string): number | null {
      const raw = row.dataset[key]
      if (!raw) return null
      const value = Number(raw)
      return Number.isFinite(value) && value >= 0 ? value : null
    }

    function compare(a: HTMLElement, b: HTMLElement, key: string): number {
      const av = number(a, key)
      const bv = number(b, key)
      if (av == null && bv == null) return 0
      if (av == null) return 1
      if (bv == null) return -1
      if (av === bv) return 0
      const best = -1 * (av - bv)
      return orderMode === "best" ? best : -best
    }

    function apply() {
      const search = q?.value.trim().toLowerCase() ?? ""
      const taskValue = task?.value ?? ""
      const contextValue = context?.value ?? ""
      const bandValue = band?.value ?? ""
      let visible = 0
      for (const row of rows) {
        const matches =
          (!search || row.dataset.name?.includes(search)) &&
          (!taskValue || row.dataset.tasks?.split(" ").includes(taskValue)) &&
          (!contextValue || row.dataset.contexts?.split(" ").includes(contextValue)) &&
          (!bandValue || row.dataset.band === bandValue)
        row.classList.toggle("hidden", !matches)
        if (matches) visible++
      }
      if (count) count.textContent = `Showing ${visible} of ${rows.length} models`
      empty?.classList.toggle("hidden", visible > 0)

      const mode = sort?.value ?? "syndication"
      setOrderLabel()
      const sorted = [...rows].sort((a, b) => {
        if (mode === "name") {
          const diff = (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "")
          return orderMode === "best" ? diff : -diff
        }
        if (mode === "released") {
          const av = a.dataset.released ?? ""
          const bv = b.dataset.released ?? ""
          if (!av && !bv) return 0
          if (!av) return 1
          if (!bv) return -1
          const diff = av.localeCompare(bv)
          return orderMode === "best" ? -diff : diff
        }
        const key =
          mode === "overall"
            ? "overall"
            : mode === "openness"
              ? "openness"
              : mode === "performance"
                ? "performance"
                : mode === "research"
                  ? "research"
                  : "score"
        return compare(a, b, key) || (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "")
      })
      for (const row of sorted) list?.append(row)

      if (note) {
        const labels: Record<string, string> = {
          overall: "overall score",
          syndication: "independent listings",
          performance: "Performance/Intelligence",
          openness: "Openness/Morality",
          research: "Research/Citation",
          released: "release date",
          name: "name",
        }
        const label = labels[mode] ?? mode
        const direction =
          mode === "name"
            ? orderMode === "best"
              ? "A–Z"
              : "Z–A"
            : mode === "released"
              ? orderMode === "best"
                ? "newest first"
                : "oldest first"
              : orderMode === "best"
                ? "high first"
                : "low first"
        note.textContent = `Sorted by ${label}, ${direction}. Missing scores sort last.`
      }

      const next = new URLSearchParams()
      if (search) next.set("q", search)
      if (taskValue) next.set("task", taskValue)
      if (contextValue) next.set("context", contextValue)
      if (bandValue) next.set("band", bandValue)
      if (mode !== "syndication") next.set("sort", mode)
      if (orderMode !== "best") next.set("order", orderMode)
      const query = next.toString()
      history.replaceState(null, "", query ? `?${query}` : location.pathname)
    }

    for (const control of [q, task, context, band, sort]) control?.addEventListener("input", apply)
    order?.addEventListener("click", () => {
      orderMode = orderMode === "best" ? "worst" : "best"
      apply()
    })
    apply()
  </script>
</Base>
