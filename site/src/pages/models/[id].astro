---
import Base from "../../layouts/Base.astro"
import CountPill from "../../components/CountPill.astro"
import TagChips from "../../components/TagChips.astro"
import {
  SCORECARD_AXIS_ORDER,
  TAG_NAMESPACE_ORDER,
  bandClass,
  formatContextCount,
  formatIndex,
  formatParams,
  getIndex,
  getModel,
  tagDefinition,
  tagPath,
  tierClass,
  tierDescription,
  type ModelRecord,
} from "../../lib/data"

export function getStaticPaths() {
  return getIndex().models.map((model) => ({
    params: { id: model.id },
    props: { model },
  }))
}

interface Props {
  model: { id: string }
}

const { model: compact } = Astro.props
const model = getModel(compact.id) as ModelRecord
const scorecard = model.scorecard
const overallComponents = scorecard
  ? [...scorecard.overall.components].sort(
      (a, b) => SCORECARD_AXIS_ORDER.indexOf(a.key as (typeof SCORECARD_AXIS_ORDER)[number]) -
        SCORECARD_AXIS_ORDER.indexOf(b.key as (typeof SCORECARD_AXIS_ORDER)[number]),
    )
  : []
const bool = (value: boolean | null | undefined) => (value === true ? "Yes" : value === false ? "No" : "Unknown")
const capabilityClass = (value: boolean | null | undefined) =>
  value === true ? "capability-yes" : value === false ? "capability-no" : "capability-unknown"
const tagGroups = TAG_NAMESPACE_ORDER.map((namespace) => ({
  namespace,
  tags: model.tags.filter((tag) => tag.startsWith(`${namespace}:`)),
})).filter((group) => group.tags.length > 0)
const otherTags = model.tags.filter(
  (tag) => !TAG_NAMESPACE_ORDER.some((namespace) => tag.startsWith(`${namespace}:`)),
)
const formatDate = (value: string | null | undefined) =>
  value
    ? new Date(value).toLocaleDateString("en-GB", {
        day: "numeric",
        month: "short",
        year: "numeric",
        timeZone: "UTC",
      })
    : null
---

<Base title={model.name} description={model.summary || `${model.name} in the Democratic AI catalogue.`}>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow"><a href="/models/">Models</a> / {model.organization}</p>
      <h1>{model.name}</h1>
      {model.summary && <p class="lede">{model.summary}</p>}
      <div class="tag-groups">
        {tagGroups.map((group) => (
          <div class="tag-group">
            <TagChips tags={group.tags} showNamespace />
          </div>
        ))}
        {otherTags.length > 0 && (
          <div class="tag-group">
            <TagChips tags={otherTags} showNamespace />
          </div>
        )}
      </div>
      <div class="release-meta">
        {model.builds.length > 0 && (
          <CountPill
            label="builds"
            count={model.builds.length}
            href="#builds"
            tone="meta-builds"
            tooltip="A build is packaging, not a new model. It inherits the base task and terms."
          />
        )}
        <a
          class={`badge ${tierClass(model.openness.tier)}`}
          href={`/models/?tier=${model.openness.tier}`}
          data-tooltip={`Filter the model index to ${model.openness.tier} models. ${tierDescription(model.openness.tier)}`}
        >
          {model.openness.tier}
        </a>
        <a
          class="chip tag-org"
          href={`/models/?q=${encodeURIComponent(model.organization)}`}
          data-tooltip="The organisation or author. Opens the model index filtered to this organisation."
        >
          org:{model.organization}
        </a>
        {model.released && (
          <a class="chip meta-released" href="/models/?sort=released" data-tooltip="Release date. Opens the model index sorted by release date.">
            released:{model.released}
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="wrap detail-grid">
    <div>
      <div class="panel" id="capabilities">
        <h2>Capabilities</h2>
        <dl class="definition">
          <dt>Tool calling</dt>
          <dd>
            <a class={`chip ${capabilityClass(model.capabilities.tool_calling)}`} href={`/models/?capability=tool-calling`} data-tooltip="Filter the model index to models that can call tools and APIs.">
              {bool(model.capabilities.tool_calling)}
            </a>
          </dd>
          <dt>Reasoning</dt>
          <dd>
            <a class={`chip ${capabilityClass(model.capabilities.reasoning)}`} href={`/models/?capability=reasoning`} data-tooltip="Filter the model index to models that support multi-step reasoning.">
              {bool(model.capabilities.reasoning)}
            </a>
          </dd>
          <dt>Structured output</dt>
          <dd>
            <a class={`chip ${capabilityClass(model.capabilities.structured_output)}`} href={`/models/?capability=structured-output`} data-tooltip="Filter the model index to models that can return typed or schema-constrained output.">
              {bool(model.capabilities.structured_output)}
            </a>
          </dd>
          <dt>Context</dt>
          <dd>
            <a
              class="chip meta-context"
              href={model.capabilities.context_tokens ? `/models/?min_context=${model.capabilities.context_tokens}` : "/models/"}
              data-tooltip="Filter the model index to models with at least this context window."
            >
              context: {formatContextCount(model.capabilities.context_tokens)}
            </a>
          </dd>
          <dt>Size</dt>
          <dd>
            <a class="chip capability" href={model.footprint.params_b ? `/models/?min_params=${model.footprint.params_b}` : "/models/"}
              data-tooltip="Filter the model index to models of at least this parameter class.">
              {formatParams(model.footprint.params_b)}
            </a>
          </dd>
          <dt>Modality</dt>
          <dd>
            {model.capabilities.modality.length > 0 ? (
              <span class="flex wrap-gap">
                {model.capabilities.modality.map((modality) => (
                  <a class="chip" href={tagPath(`modality:${modality}`)} title={tagDefinition(`modality:${modality}`)}>
                    {modality}
                  </a>
                ))}
              </span>
            ) : (
              "Unknown"
            )}
          </dd>
          <dt>Runtimes</dt>
          <dd>
            {model.capabilities.runtimes.length > 0 ? (
              <span class="flex wrap-gap">
                {model.capabilities.runtimes.map((runtime) => (
                  <a class="chip" href={tagPath(`runtime:${runtime}`)} title={tagDefinition(`runtime:${runtime}`)}>
                    {runtime}
                  </a>
                ))}
              </span>
            ) : (
              "Unknown"
            )}
          </dd>
        </dl>
      </div>

      <div class="panel" id="builds">
        <h2>Builds</h2>
        {model.builds.length > 0 ? (
          <>
            <p class="muted" style="font-size:0.9rem">
              A build is packaging, not a new model. It inherits the base task and terms.
            </p>
            <div class="table-wrap">
              <table class="build-table">
                <thead>
                  <tr><th>Build</th><th>Runtime</th><th>Quantization</th><th>Relation</th><th></th></tr>
                </thead>
                <tbody>
                  {model.builds.map((build) => (
                    <tr>
                      <td>{build.name}</td>
                      <td>{build.runtime.length > 0 ? build.runtime.join(", ") : "—"}</td>
                      <td>{build.quantization ?? "—"}</td>
                      <td>{build.relation ?? "build"}</td>
                      <td><a href={build.url} target="_blank" rel="noreferrer">Hugging Face</a></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        ) : (
          <p class="muted">No builds in this pull. A build is a packaging, not a separate model.</p>
        )}
      </div>

      {model.releases.length > 0 && (
        <div class="panel" id="releases">
          <h2>Releases</h2>
          <p class="muted" style="font-size:0.9rem">
            These earlier names and updates are the same model lineage. They fold into this page.
          </p>
          <div class="table-wrap">
            <table class="build-table">
              <thead>
                <tr><th>Date</th><th>Release</th><th>Relation</th><th>Note</th><th></th></tr>
              </thead>
              <tbody>
                {model.releases.map((release) => (
                  <tr>
                    <td>{release.released ?? "—"}</td>
                    <td>{release.name}</td>
                    <td>{release.relation}</td>
                    <td>{release.note}</td>
                    <td><a href={`https://huggingface.co/${release.hugging_face}`} target="_blank" rel="noreferrer">Hugging Face</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      <div class="panel">
        <h2>Lineage</h2>
        {model.lineage.length > 0 ? (
          <div class="lineage">
            {model.lineage.map((entry) => (
              <>
                <a class="chip" href={tagPath(`relation:${entry.relation}`)} title={tagDefinition(`relation:${entry.relation}`)}>
                  {entry.relation}
                </a>
                <span class="arrow">←</span>
                <a href={`https://huggingface.co/${entry.base}`} target="_blank" rel="noreferrer">{entry.base}</a>
              </>
            ))}
          </div>
        ) : (
          <p class="muted">No base model declared. This is a root release, or the card does not name a base.</p>
        )}
      </div>
    </div>

    <aside id="scorecard">
      {scorecard ? (
        <>
          <div class="panel scorecard-panel scorecard-overall" id="scorecard-overall">
            <h2>Overall score</h2>
            <div class="score-block">
              <strong>{formatIndex(scorecard.overall.score)}</strong>
              <span class="faint">{scorecard.overall.coverage} of 4 axes</span>
            </div>
            <p class="muted" style="font-size:0.84rem">{scorecard.overall.note}</p>
            <ul class="overall-list">
              <li class="overall-row overall-head">
                <span>axis</span>
                <span>weight</span>
                <span>contribution</span>
              </li>
              {overallComponents.map((component) => (
                <li class="overall-row">
                  <CountPill
                    class="overall-pill"
                    label={component.key === "research" ? "citation" : component.key}
                    count={
                      !component.included
                        ? "—"
                        : component.key === "syndication"
                          ? `${formatIndex((component.score ?? 0) / 10)}/10`
                          : formatIndex(component.score)
                    }
                    href={`#scorecard-${component.key}`}
                    tone={`score-${component.key}`}
                    tooltip={
                      component.included
                        ? `${component.label}: ${component.effective_weight}% of the overall score, contributing ${formatIndex(component.contribution)}.`
                        : `${component.label} has no current value, so it is excluded from the overall score. Missing is not zero.`
                    }
                  />
                  <span class="overall-weight">{component.included ? `${component.effective_weight}%` : "—"}</span>
                  <span class="overall-contribution">{component.included ? formatIndex(component.contribution) : "—"}</span>
                </li>
              ))}
            </ul>
            <p class="mono-small muted">
              Base weights: syndication 15, performance 40, openness 30, citation 15. Missing axes are excluded and the
              remaining weights are renormalised.
            </p>
          </div>

          <div class="panel scorecard-panel scorecard-openness" id="scorecard-openness">
            <h2>Openness/Morality</h2>
            <div class="score-block"><strong>{formatIndex(scorecard.openness_morality.score)}</strong></div>
            <ul class="metric-list">
              {scorecard.openness_morality.components.map((component) => (
                <li class="metric-row">
                  <span class="metric-label">{component.label}</span>
                  <a
                    class={`chip ${component.label === "Licence" ? "tag-license" : ""}`.trim()}
                    href={component.label === "Licence" ? tagPath(`license:${component.value}`) : "/about/#release-terms"}
                    data-tooltip={
                      component.label === "Licence"
                        ? tagDefinition(`license:${component.value}`)
                        : component.label === "Weights"
                          ? "open-weight means the trained weights are downloadable. It does not mean the training data or code are open."
                          : component.label === "Training data"
                            ? "open means the data is published. documented means it is described but not released. unknown means unchecked, not closed."
                            : "open means the training code is published. documented means it is described but not released. unknown means unchecked, not closed."
                    }
                  >
                    {component.value}
                  </a>
                  <span class="metric-points">{component.points}/{component.max}</span>
                </li>
              ))}
            </ul>
            <p class="muted" style="font-size:0.84rem">{scorecard.openness_morality.note}</p>
            <p class="mono-small muted">
              Tier:
              <a
                href="/about/#release-terms"
                data-tooltip={tierDescription(scorecard.openness_morality.tier)}
              >
                {scorecard.openness_morality.tier}
              </a>
            </p>
          </div>

          <div class="panel scorecard-panel scorecard-performance" id="scorecard-performance">
            <h2>Performance/Intelligence</h2>
            <div class="score-block">
              <strong class={scorecard.performance.score == null ? "unmeasured" : ""}>{formatIndex(scorecard.performance.score)}</strong>
              {scorecard.performance.score == null && <span class="faint">Not measured</span>}
            </div>
            <p class="muted" style="font-size:0.84rem">{scorecard.performance.note}</p>
            {scorecard.performance.benchmarks.length > 0 && (
              <ul class="benchmark-list">
                {scorecard.performance.benchmarks.map((benchmark) => (
                  <li>
                    <span>{benchmark.name}</span>
                    <span class="mono-small">{formatIndex(benchmark.score)}{benchmark.self_reported ? " *" : ""}</span>
                  </li>
                ))}
              </ul>
            )}
            {scorecard.performance.own_benchmarks.length > 0 && (
              <details class="own-evidence">
                <summary>Own evidence from this release</summary>
                <ul class="benchmark-list">
                  {scorecard.performance.own_benchmarks.map((benchmark) => (
                    <li>
                      <span>{benchmark.name}</span>
                      <span class="mono-small">{formatIndex(benchmark.score)}{benchmark.self_reported ? " *" : ""}</span>
                    </li>
                  ))}
                </ul>
              </details>
            )}
            <p class="mono-small muted">
              {scorecard.performance.basis ? `${scorecard.performance.basis} basis` : "No basis"}
              {scorecard.performance.match === "base" ? " · base-model match" : ""}
              {scorecard.performance.as_of ? ` · ${formatDate(scorecard.performance.as_of)}` : ""}
            </p>
            {scorecard.performance.source && (
              <a class="mono-small" href={scorecard.performance.source} target="_blank" rel="noreferrer">Source</a>
            )}
          </div>

          <div class="panel scorecard-panel scorecard-research" id="scorecard-research">
            <h2>Citation/Research</h2>
            <div class="score-block">
              <strong class={scorecard.research_citation.score == null ? "unmeasured" : ""}>{formatIndex(scorecard.research_citation.score)}</strong>
              {scorecard.research_citation.score == null && <span class="faint">Not measured</span>}
            </div>
            <p class="muted" style="font-size:0.84rem">{scorecard.research_citation.note}</p>
            {scorecard.research_citation.benchmarks.length > 0 && (
              <ul class="benchmark-list">
                {scorecard.research_citation.benchmarks.map((benchmark) => (
                  <li>
                    <span>{benchmark.name}</span>
                    <span class="mono-small">{formatIndex(benchmark.score)}</span>
                  </li>
                ))}
              </ul>
            )}
            <p class="mono-small muted">Citation accuracy: {scorecard.research_citation.citation}</p>
            {scorecard.research_citation.source && (
              <a class="mono-small" href={scorecard.research_citation.source} target="_blank" rel="noreferrer">Source</a>
            )}
          </div>

          <div class="panel scorecard-panel scorecard-syndication" id="scorecard-syndication">
            <h2>Syndication</h2>
            <div class="score-block">
              <strong>{scorecard.syndication.score}</strong><span class="faint">/{scorecard.syndication.max}</span>
              <a
                class={`badge ${bandClass(scorecard.syndication.band)}`}
                href={`/models/?band=${scorecard.syndication.band}`}
                data-tooltip="Filter the model index to this syndication band. The band groups independent listings; it is not a quality grade."
              >
                {scorecard.syndication.band.replaceAll("-", " ")}
              </a>
            </div>
            <p class="muted" style="font-size:0.84rem">{scorecard.syndication.note}</p>
            <ul class="source-list">
              {model.syndication.sources.map((source) => (
                <li>
                  <a href={source.url} target="_blank" rel="noreferrer">{source.id}</a>
                  <span class="weight">+{source.weight}{source.self ? " self" : ""}</span>
                </li>
              ))}
            </ul>
          </div>
        </>
      ) : (
        <div class="panel">
          <h2>Scorecard</h2>
          <p class="muted">No scorecard entry for this model yet. Missing is not zero.</p>
        </div>
      )}

      <div class="panel">
        <h2>Access</h2>
        <dl class="definition">
          <dt>Hugging Face</dt>
          <dd><a href={`https://huggingface.co/${model.access.hugging_face}`} target="_blank" rel="noreferrer">{model.access.hugging_face}</a></dd>
          <dt>models.dev</dt>
          <dd>{model.access.models_dev ? <a href={model.access.models_dev} target="_blank" rel="noreferrer">Open entry</a> : "No entry"}</dd>
          <dt>agent-detect</dt>
          <dd>{model.access.agent_detect ? <a href={model.access.agent_detect} target="_blank" rel="noreferrer">Open entry</a> : "No entry"}</dd>
          <dt>Gated</dt>
          <dd>{model.access.gated === true || model.access.gated === "auto" || model.access.gated === "manual" ? "Yes" : model.access.gated === false ? "No" : "Unknown"}</dd>
        </dl>
      </div>

      <div class="panel" id="terms">
        <h2>Terms</h2>
        <dl class="definition">
          <dt>Licence</dt>
          <dd>
            <a
              class="chip tag-license"
              href={tagPath(`license:${model.license.id}`)}
              data-tooltip={tagDefinition(`license:${model.license.id}`)}
            >
              {model.license.id}
            </a>
          </dd>
          <dt>Weights</dt>
          <dd>
            <a
              class="chip"
              href="/about/#release-terms"
              data-tooltip="open-weight means the trained weights are downloadable. It does not mean the training data or code are open."
            >
              {model.openness.weights}
            </a>
          </dd>
          <dt>Training data</dt>
          <dd>
            <a
              class="chip"
              href="/about/#release-terms"
              data-tooltip="open means the data is published. documented means it is described but not released. unknown means unchecked, not closed."
            >
              {model.openness.training_data}
            </a>
          </dd>
          <dt>Training code</dt>
          <dd>
            <a
              class="chip"
              href="/about/#release-terms"
              data-tooltip="open means the training code is published. documented means it is described but not released. unknown means unchecked, not closed."
            >
              {model.openness.training_code}
            </a>
          </dd>
          <dt>Tier</dt>
          <dd>
            <a
              class={`badge ${tierClass(model.openness.tier)}`}
              href="/about/#release-terms"
              data-tooltip={tierDescription(model.openness.tier)}
            >
              {model.openness.tier}
            </a>
          </dd>
        </dl>
        <p class="muted" style="font-size:0.82rem;margin-top:0.8rem">
          Training-data and training-code evidence is not assessed in this pass. `unknown` means unchecked, not closed.
        </p>
      </div>

      <div class="panel">
        <h2>Sources</h2>
        <ul class="source-list">
          {model.sources.map((source) => (
            <li><a href={source.url} target="_blank" rel="noreferrer">{source.kind}</a><span class="weight">{source.retrieved_at}</span></li>
          ))}
        </ul>
      </div>
    </aside>
  </section>
</Base>
