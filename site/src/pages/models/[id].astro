---
import Base from "../../layouts/Base.astro"
import ScoreBadge from "../../components/ScoreBadge.astro"
import TagChips from "../../components/TagChips.astro"
import { bandClass, getIndex, getModel, tierClass, formatContext, formatParams, type ModelRecord } from "../../lib/data"

export function getStaticPaths() {
  return getIndex().models.map((model) => ({
    params: { id: model.id },
    props: { model },
  }))
}

interface Props {
  model: { id: string }
}

const { model: compact } = Astro.props
const model = getModel(compact.id) as ModelRecord
const bool = (value: boolean | null | undefined) => (value === true ? "Yes" : value === false ? "No" : "Unknown")
const taskTags = model.tags.filter((tag) => tag.startsWith("task:"))
---

<Base title={model.name} description={model.summary || `${model.name} in the Democratic AI catalogue.`}>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow"><a href="/models/">Models</a> / {model.organization}</p>
      <h1>{model.name}</h1>
      {model.summary && <p class="lede">{model.summary}</p>}
      <div class="badges">
        <span class={`badge ${tierClass(model.openness.tier)}`}>{model.openness.tier}</span>
        <ScoreBadge score={model.syndication.score} band={model.syndication.band} detail />
        <span class="chip license">{model.license.id}</span>
        <span class="chip">{model.organization}</span>
        {model.released && <span class="chip">{model.released}</span>}
        {model.builds.length > 0 && <span class="chip">{model.builds.length} builds</span>}
      </div>
    </div>
  </section>

  <section class="wrap detail-grid">
    <div>
      <div class="panel">
        <h2>What it does</h2>
        {taskTags.length > 0 ? <TagChips tags={taskTags} /> : <p class="muted">No task tag yet.</p>}
        <dl class="definition mt-3">
          <dt>Tool calling</dt><dd>{bool(model.capabilities.tool_calling)}</dd>
          <dt>Reasoning</dt><dd>{bool(model.capabilities.reasoning)}</dd>
          <dt>Structured output</dt><dd>{bool(model.capabilities.structured_output)}</dd>
          <dt>Context</dt><dd>{formatContext(model.capabilities.context_tokens)}</dd>
          <dt>Size</dt><dd>{formatParams(model.footprint.params_b)}</dd>
          <dt>Modality</dt><dd>{model.capabilities.modality.length > 0 ? model.capabilities.modality.join(", ") : "Unknown"}</dd>
          <dt>Runtimes</dt><dd>{model.capabilities.runtimes.length > 0 ? model.capabilities.runtimes.join(", ") : "Unknown"}</dd>
        </dl>
      </div>

      <div class="panel">
        <h2>Builds</h2>
        {model.builds.length > 0 ? (
          <>
            <p class="muted" style="font-size:0.9rem">
              A build is packaging, not a new model. It inherits the base task and terms.
            </p>
            <div class="table-wrap">
              <table class="build-table">
                <thead>
                  <tr><th>Build</th><th>Runtime</th><th>Quantization</th><th>Relation</th><th></th></tr>
                </thead>
                <tbody>
                  {model.builds.map((build) => (
                    <tr>
                      <td>{build.name}</td>
                      <td>{build.runtime.length > 0 ? build.runtime.join(", ") : "—"}</td>
                      <td>{build.quantization ?? "—"}</td>
                      <td>{build.relation ?? "build"}</td>
                      <td><a href={build.url} target="_blank" rel="noreferrer">Hugging Face</a></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        ) : (
          <p class="muted">No builds in this pull. A build is a packaging, not a separate model.</p>
        )}
      </div>

      <div class="panel">
        <h2>Lineage</h2>
        {model.lineage.length > 0 ? (
          <div class="lineage">
            {model.lineage.map((entry) => (
              <>
                <span class="chip">{entry.relation}</span>
                <span class="arrow">←</span>
                <a href={`https://huggingface.co/${entry.base}`} target="_blank" rel="noreferrer">{entry.base}</a>
              </>
            ))}
          </div>
        ) : (
          <p class="muted">No base model declared. This is a root release, or the card does not name a base.</p>
        )}
      </div>

      <div class="panel">
        <h2>Tags</h2>
        <TagChips tags={model.tags} showNamespace />
      </div>
    </div>

    <aside>
      <div class="panel">
        <h2>Syndication</h2>
        <div class="score-block">
          <strong>{model.syndication.score}</strong><span class="faint">/10</span>
          <span class={`badge ${bandClass(model.syndication.band)}`}>{model.syndication.band.replaceAll("-", " ")}</span>
        </div>
        <p class="muted" style="font-size:0.84rem">
          Independent listings, not quality. The model's own Hugging Face page has weight 0.
        </p>
        <ul class="source-list">
          {model.syndication.sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noreferrer">{source.id}</a>
              <span class="weight">+{source.weight}{source.self ? " self" : ""}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="panel">
        <h2>Access</h2>
        <dl class="definition">
          <dt>Hugging Face</dt>
          <dd><a href={`https://huggingface.co/${model.access.hugging_face}`} target="_blank" rel="noreferrer">{model.access.hugging_face}</a></dd>
          <dt>models.dev</dt>
          <dd>{model.access.models_dev ? <a href={model.access.models_dev} target="_blank" rel="noreferrer">Open entry</a> : "No entry"}</dd>
          <dt>agent-detect</dt>
          <dd>{model.access.agent_detect ? <a href={model.access.agent_detect} target="_blank" rel="noreferrer">Open entry</a> : "No entry"}</dd>
          <dt>Gated</dt>
          <dd>{model.access.gated === true || model.access.gated === "auto" || model.access.gated === "manual" ? "Yes" : model.access.gated === false ? "No" : "Unknown"}</dd>
        </dl>
      </div>

      <div class="panel">
        <h2>Terms</h2>
        <dl class="definition">
          <dt>Licence</dt><dd>{model.license.id} <span class="faint">({model.license.class})</span></dd>
          <dt>Weights</dt><dd>{model.openness.weights}</dd>
          <dt>Training data</dt><dd>{model.openness.training_data}</dd>
          <dt>Training code</dt><dd>{model.openness.training_code}</dd>
          <dt>Tier</dt><dd><span class={`badge ${tierClass(model.openness.tier)}`}>{model.openness.tier}</span></dd>
        </dl>
        <p class="muted" style="font-size:0.82rem;margin-top:0.8rem">
          Training-data and training-code evidence is not assessed in this pass. `unknown` means unchecked, not closed.
        </p>
      </div>

      <div class="panel">
        <h2>Sources</h2>
        <ul class="source-list">
          {model.sources.map((source) => (
            <li><a href={source.url} target="_blank" rel="noreferrer">{source.kind}</a><span class="weight">{source.retrieved_at}</span></li>
          ))}
        </ul>
      </div>
    </aside>
  </section>
</Base>
