---
import Base from "../../layouts/Base.astro"
import CountPill from "../../components/CountPill.astro"
import ComparePicker from "../../components/ComparePicker.astro"
import Pill from "../../components/Pill.astro"
import PillRow from "../../components/PillRow.astro"
import TagChips from "../../components/TagChips.astro"
import {
  SCORECARD_AXIS_ORDER,
  TAG_NAMESPACE_ORDER,
  bandClass,
  formatContextCount,
  formatIndex,
  formatParams,
  getIndex,
  getModel,
  tagDefinition,
  tagPath,
  tagStatus,
  tierDescription,
  type ModelRecord,
} from "../../lib/data"

export function getStaticPaths() {
  return getIndex().models.map((model) => ({
    params: { id: model.id },
    props: { model },
  }))
}

interface Props {
  model: { id: string }
}

const { model: compact } = Astro.props
const model = getModel(compact.id) as ModelRecord
const scorecard = model.scorecard
const overallComponents = scorecard
  ? [...scorecard.overall.components].sort(
      (a, b) => SCORECARD_AXIS_ORDER.indexOf(a.key as (typeof SCORECARD_AXIS_ORDER)[number]) -
        SCORECARD_AXIS_ORDER.indexOf(b.key as (typeof SCORECARD_AXIS_ORDER)[number]),
    )
  : []
const bool = (value: boolean | null | undefined) => (value === true ? "Yes" : value === false ? "No" : "Unknown")
const tagGroups = TAG_NAMESPACE_ORDER.map((namespace) => ({
  namespace,
  tags: model.tags.filter((tag) => tag.startsWith(`${namespace}:`)),
})).filter((group) => group.tags.length > 0)
const otherTags = model.tags.filter(
  (tag) => !TAG_NAMESPACE_ORDER.some((namespace) => tag.startsWith(`${namespace}:`)),
)
const accessTags = model.tags.filter((tag) => tag.startsWith("access:"))
const structuredOutputDefinition = "Return typed or schema-constrained output."

interface PillLinkData {
  label: string
  href: string
  external?: boolean
}

interface PillRowData {
  label: string
  explanation: string
  href: string
  tone?: string
  missing?: boolean
  website?: { label: string; href: string }
  links?: PillLinkData[]
}

const filterHref = (params: Record<string, string | number>) => {
  const search = new URLSearchParams()
  for (const [key, value] of Object.entries(params)) search.set(key, String(value))
  return `/models/?${search.toString()}`
}

const tagRow = (tag: string): PillRowData => ({
  label: tag,
  explanation: tagDefinition(tag),
  href: filterHref({ filter: tag }),
  tone: tagStatus(tag),
})

const orgNames: Record<string, string> = {
  deepseek: "DeepSeek",
  mistral: "Mistral AI",
  zai: "Z.ai",
  qwen: "Qwen",
  minimax: "MiniMax",
  "moonshot-ai": "Moonshot AI",
  "thinking-machines-lab": "Thinking Machines Lab",
  "liquid-ai": "Liquid AI",
  "ant-ling": "Ant Ling",
  "xiaomi-mimo": "Xiaomi MiMo",
  stepfun: "StepFun",
  "nace-ai": "Nace AI",
}

const orgWebsites: Record<string, string> = {
  deepseek: "https://www.deepseek.com",
  mistral: "https://mistral.ai",
  zai: "https://z.ai",
  qwen: "https://qwen.ai",
  minimax: "https://www.minimax.io",
  "moonshot-ai": "https://www.moonshot.ai",
  "thinking-machines-lab": "https://thinkingmachines.ai",
  "liquid-ai": "https://www.liquid.ai",
  "ant-ling": "https://www.antgroup.com",
  "xiaomi-mimo": "https://www.mi.com",
  stepfun: "https://www.stepfun.com",
  "nace-ai": "https://nace.ai",
}

const accessInfoLinks: Record<string, PillLinkData> = {
  huggingface: { label: "Hugging Face model card", href: `https://huggingface.co/${model.access.hugging_face}`, external: true },
  vllm: { label: "vLLM", href: "https://docs.vllm.ai", external: true },
  sglang: { label: "SGLang", href: "https://docs.sglang.ai", external: true },
  opencode: { label: "OpenCode", href: "https://opencode.ai", external: true },
  cloudflare: { label: "Cloudflare Workers AI", href: "https://developers.cloudflare.com/workers-ai/", external: true },
  openrouter: { label: "OpenRouter", href: "https://openrouter.ai", external: true },
  python: { label: "Python", href: "https://www.python.org", external: true },
  mlx: { label: "MLX", href: "https://ml-explore.github.io/mlx/", external: true },
  "llama.cpp": { label: "llama.cpp", href: "https://github.com/ggml-org/llama.cpp", external: true },
  ollama: { label: "Ollama", href: "https://ollama.com", external: true },
  litert: { label: "LiteRT", href: "https://ai.google.dev/edge/litert", external: true },
  webgpu: { label: "WebGPU", href: "https://developer.mozilla.org/en-US/docs/Web/API/WebGPU_API", external: true },
  onnx: { label: "ONNX Runtime", href: "https://onnxruntime.ai", external: true },
  coreml: { label: "Core ML", href: "https://developer.apple.com/documentation/coreml", external: true },
  android: { label: "Android", href: "https://developer.android.com", external: true },
  ios: { label: "iOS", href: "https://developer.apple.com/ios/", external: true },
  node: { label: "Node.js", href: "https://nodejs.org", external: true },
  browser: { label: "WebAssembly", href: "https://webassembly.org", external: true },
}

const accessRows: PillRowData[] = [
  {
    label: "access:huggingface",
    explanation: "The weights and model card on Hugging Face.",
    href: filterHref({ access: "huggingface" }),
    tone: "tag-access",
    links: [accessInfoLinks.huggingface],
  },
  {
    label: "access:models.dev",
    explanation: model.access.models_dev
      ? "Hosted providers, pricing, and model metadata on models.dev."
      : "Hosted providers, pricing, and model metadata. No models.dev entry is recorded for this model.",
    href: filterHref({ access: "models.dev" }),
    tone: "tag-access",
    missing: !model.access.models_dev,
    links: model.access.models_dev
      ? [{ label: "models.dev entry", href: model.access.models_dev, external: true }]
      : [],
  },
  {
    label: "access:agent-detect",
    explanation: model.access.agent_detect
      ? "Harness and provider identification on agent-detect."
      : "Harness and provider identification. No agent-detect entry is recorded for this model.",
    href: filterHref({ access: "agent-detect" }),
    tone: "tag-access",
    missing: !model.access.agent_detect,
    links: model.access.agent_detect
      ? [{ label: "agent-detect entry", href: model.access.agent_detect, external: true }]
      : [],
  },
  ...accessTags.map((tag) => {
    const runtime = tag.slice("access:".length)
    const info = accessInfoLinks[runtime]
    return {
      label: `access:${runtime}`,
      explanation: tagDefinition(tag),
      href: filterHref({ filter: tag }),
      tone: "tag-access",
      links: info ? [info] : [],
    }
  }),
]

const capabilityRows: PillRowData[] = [
  {
    label: "capability:structured-output",
    explanation:
      model.capabilities.structured_output === true
        ? structuredOutputDefinition
        : `${structuredOutputDefinition} Not recorded for this model.`,
    href: filterHref({ capability: "structured-output" }),
    tone: "tag-capability",
    missing: model.capabilities.structured_output !== true,
  },
  {
    label:
      model.capabilities.context_tokens == null
        ? "context:unknown"
        : `context:${formatContextCount(model.capabilities.context_tokens)}`,
    explanation:
      model.capabilities.context_tokens == null
        ? "The maximum number of tokens the model can consider at once. Not recorded for this model."
        : `${formatContextCount(model.capabilities.context_tokens)} tokens. The maximum number of tokens the model can consider at once.`,
    href: filterHref({ min_context: model.capabilities.context_tokens ?? 1 }),
    tone: "tag-capability",
    missing: model.capabilities.context_tokens == null,
  },
  {
    label: model.footprint.params_b == null ? "size:unknown" : `size:${model.footprint.params_b}B`,
    explanation:
      model.footprint.params_b == null
        ? "The model's parameter count. Use it to estimate weights and memory. Not recorded for this model."
        : `${formatParams(model.footprint.params_b)}. The model's parameter count. Use it to estimate weights and memory.`,
    href: filterHref({ min_params: model.footprint.params_b ?? 1 }),
    tone: "tag-capability",
    missing: model.footprint.params_b == null,
  },
]

const formatDate = (value: string | null | undefined) =>
  value
    ? new Date(value).toLocaleDateString("en-GB", {
        day: "numeric",
        month: "short",
        year: "numeric",
        timeZone: "UTC",
      })
    : null

const capabilityCardRows: PillRowData[] = [
  ...model.tags.filter((tag) => tag.startsWith("task:")).map(tagRow),
  ...model.tags.filter((tag) => tag.startsWith("domain:")).map(tagRow),
  ...model.tags.filter((tag) => tag.startsWith("modality:")).map(tagRow),
  ...model.tags.filter((tag) => tag.startsWith("language:")).map(tagRow),
  ...model.tags.filter((tag) => tag.startsWith("family:")).map(tagRow),
  ...model.tags.filter((tag) => tag.startsWith("status:")).map(tagRow),
  ...model.tags.filter((tag) => tag.startsWith("relation:")).map(tagRow),
  ...capabilityRows,
]

const releaseRows: PillRowData[] = [
  {
    label: `org:${model.organization}`,
    explanation: `${orgNames[model.organization] ?? model.organization} is the organisation behind this model.`,
    href: filterHref({ q: model.organization }),
    tone: "tag-release",
    website: orgWebsites[model.organization]
      ? { label: orgNames[model.organization] ?? model.organization, href: orgWebsites[model.organization] }
      : undefined,
  },
  {
    label: model.released ? `released:${model.released}` : "released:unknown",
    explanation: model.released
      ? `Released on ${formatDate(model.released)}.`
      : "The release date is not recorded for this model.",
    href: filterHref({ sort: "released" }),
    tone: "tag-release",
    missing: !model.released,
  },
  {
    label: `builds:${model.builds.length}`,
    explanation:
      model.builds.length === 0
        ? "No builds are attached. A build is packaging, not a new model. It inherits the base task and terms."
        : `${model.builds.length} build${model.builds.length === 1 ? "" : "s"} attached. A build is packaging, not a new model. It inherits the base task and terms.`,
    href: filterHref({ min_builds: model.builds.length }),
    tone: "tag-release",
  },
]

const weightsValue = model.openness.weights === "open-weight" ? "open" : model.openness.weights
const termRows: PillRowData[] = [
  {
    label: `weights:${weightsValue}`,
    explanation:
      model.openness.weights === "unknown"
        ? "The weight status is not recorded for this model. This is not the same as closed."
        : "The weights are open and downloadable. Open-weight does not mean the training data or code are open.",
    href: filterHref({ weights: weightsValue }),
    tone: "tag-terms",
    missing: model.openness.weights === "unknown",
  },
  {
    label: `training-data:${model.openness.training_data}`,
    explanation:
      model.openness.training_data === "unknown"
        ? "The training data is not recorded for this model. Unchecked is not the same as closed."
        : model.openness.training_data === "open"
          ? "The training data is open and published."
          : "The training data is documented but not released.",
    href: filterHref({ training_data: model.openness.training_data }),
    tone: "tag-terms",
    missing: model.openness.training_data === "unknown",
  },
  {
    label: `training-code:${model.openness.training_code}`,
    explanation:
      model.openness.training_code === "unknown"
        ? "The training code is not recorded for this model. Unchecked is not the same as closed."
        : model.openness.training_code === "open"
          ? "The training code is open and published."
          : "The training code is documented but not released.",
    href: filterHref({ training_code: model.openness.training_code }),
    tone: "tag-terms",
    missing: model.openness.training_code === "unknown",
  },
  {
    label: `tier:${model.openness.tier}`,
    explanation: tierDescription(model.openness.tier),
    href: filterHref({ tier: model.openness.tier }),
    tone: "tag-terms",
  },
]

const contextRows = model.tags.filter((tag) => tag.startsWith("context:")).map(tagRow)
const licensingRows = model.tags.filter((tag) => tag.startsWith("licensing:")).map(tagRow)
const licenceRows = model.tags.filter((tag) => tag.startsWith("license:")).map(tagRow)
const termsCardRows: PillRowData[] = [
  ...contextRows,
  ...licensingRows,
  ...(licenceRows.length > 0
    ? licenceRows
    : [
        {
          label: "license:unknown",
          explanation: "The licence is not recorded. The reuse terms are unknown for this model.",
          href: filterHref({ license: "unknown" }),
          tone: "tag-terms",
          missing: true,
        },
      ]),
  ...termRows,
]

const providers = model.access.providers ?? []
const providerModels = model.access.provider_models ?? {}
const openCodeProvider = providerModels.opencode?.length ? "opencode" : providerModels["opencode-go"]?.length ? "opencode-go" : null
const openCodeModels = openCodeProvider ? providerModels[openCodeProvider] : []
const isFreeProviderModel = (entry: { id: string; cost: { input?: number; output?: number } | null }) =>
  entry.cost?.input === 0 && entry.cost?.output === 0
const openCode = openCodeModels.find(isFreeProviderModel) ?? openCodeModels[0]
const openCodeFree = openCode ? isFreeProviderModel(openCode) : false
const cloudflareModel = providerModels["cloudflare-workers-ai"]?.[0]
const openRouterModel = providerModels.openrouter?.[0]
const hostedRuntimes = new Set(["opencode", "cloudflare", "openrouter", "hosted"])
const localRuntimes = model.capabilities.runtimes.filter((runtime) => !hostedRuntimes.has(runtime))
const usage = model.usage ?? []
const hasOpenCode = Boolean(openCode)
const hasCloudflare = Boolean(cloudflareModel)
const hasOpenRouter = Boolean(openRouterModel)
const openCodeStep = 1
const cloudflareStep = hasOpenCode ? 2 : 1
const openRouterStep = (hasOpenCode ? 1 : 0) + (hasCloudflare ? 1 : 0) + 1
const diyStep = (hasOpenCode ? 1 : 0) + (hasCloudflare ? 1 : 0) + (hasOpenRouter ? 1 : 0) + 1
const memoryLow = model.footprint.params_b == null ? null : Math.ceil(model.footprint.params_b * 0.55)
const memoryHigh = model.footprint.params_b == null ? null : Math.ceil(model.footprint.params_b * 2)
---

<Base title={model.name} description={model.summary || `${model.name} in the Democratic AI catalogue.`}>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow"><a href="/models/">Models</a> / {model.organization}</p>
      <h1>{model.name}</h1>
      {model.summary && <p class="lede">{model.summary}</p>}
      <div class="tag-groups">
        {tagGroups.map((group) => (
          <div class="tag-group">
            <TagChips tags={group.tags} showNamespace />
          </div>
        ))}
        {otherTags.length > 0 && (
          <div class="tag-group">
            <TagChips tags={otherTags} showNamespace />
          </div>
        )}
      </div>
      <div class="release-meta">
        {model.builds.length > 0 && (
          <Pill
            label={`builds:${model.builds.length}`}
            href="#builds"
            tone="tag-release"
            tooltip="A build is packaging, not a new model. It inherits the base task and terms."
          />
        )}
        <Pill
          label={`tier:${model.openness.tier}`}
          href={`/models/?tier=${model.openness.tier}`}
          tone="tag-terms"
          tooltip={tierDescription(model.openness.tier)}
        />
        <Pill
          label={`org:${model.organization}`}
          href={`/models/?q=${encodeURIComponent(model.organization)}`}
          tone="tag-release"
          tooltip={`${orgNames[model.organization] ?? model.organization} is the organisation behind this model.`}
        />
        {model.released && (
          <Pill
            label={`released:${model.released}`}
            href="/models/?sort=released"
            tone="tag-release"
            tooltip={`Released on ${formatDate(model.released)}.`}
          />
        )}
      </div>
    </div>
  </section>

  <section class="wrap detail-grid">
    <div>
      <div class="panel" id="capabilities">
        <h2>Capabilities</h2>
        <ul class="tag-explain">
          {capabilityCardRows.map((row) => <PillRow {...row} />)}
        </ul>
      </div>

      <div class="panel" id="access">
        <h2>Access</h2>
        <ul class="tag-explain">
          {accessRows.map((row) => <PillRow {...row} />)}
        </ul>
      </div>

      <div class="panel" id="terms">
        <h2>Terms</h2>
        <ul class="tag-explain">
          {termsCardRows.map((row) => <PillRow {...row} />)}
        </ul>
        <p class="muted" style="font-size:0.82rem;margin-top:0.8rem">
          Training-data and training-code evidence is not assessed in this pass. `unknown` means unchecked, not closed.
        </p>
      </div>

      <div class="panel" id="release">
        <h2>Release</h2>
        <ul class="tag-explain">
          {releaseRows.map((row) => <PillRow {...row} />)}
        </ul>
        {model.releases.length > 0 && (
          <div id="releases" style="margin-top:1.2rem">
            <h3>Release history</h3>
            <p class="muted" style="font-size:0.9rem">
              These earlier names and updates are the same model lineage. They fold into this page.
            </p>
            <div class="table-wrap">
              <table class="build-table">
                <thead>
                  <tr><th>Date</th><th>Release</th><th>Relation</th><th>Note</th><th></th></tr>
                </thead>
                <tbody>
                  {model.releases.map((release) => (
                    <tr>
                      <td>{release.released ?? "—"}</td>
                      <td>{release.name}</td>
                      <td>{release.relation}</td>
                      <td>{release.note}</td>
                      <td><a href={`https://huggingface.co/${release.hugging_face}`} target="_blank" rel="noreferrer">Hugging Face</a></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </div>

      <div class="panel" id="lineage">
        <h2>Lineage</h2>
        {model.lineage.length > 0 ? (
          <div class="lineage">
            {model.lineage.map((entry) => (
              <>
                <span class="lineage-relation">{entry.relation} of</span>
                <span class="arrow">←</span>
                <a href={`https://huggingface.co/${entry.base}`} target="_blank" rel="noreferrer">{entry.base}</a>
              </>
            ))}
          </div>
        ) : (
          <p class="muted">No base model declared. This is a root release, or the card does not name a base.</p>
        )}
      </div>

      <div class="panel" id="builds">
        <h2>Builds</h2>
        {model.builds.length > 0 ? (
          <>
            <p class="muted" style="font-size:0.9rem">
              A build is packaging, not a new model. It inherits the base task and terms.
            </p>
            <div class="table-wrap">
              <table class="build-table">
                <thead>
                  <tr><th>Build</th><th>Runtime</th><th>Quantization</th><th>Relation</th><th></th></tr>
                </thead>
                <tbody>
                  {model.builds.map((build) => (
                    <tr>
                      <td>{build.name}</td>
                      <td>{build.runtime.length > 0 ? build.runtime.join(", ") : "—"}</td>
                      <td>{build.quantization ?? "—"}</td>
                      <td>{build.relation ?? "build"}</td>
                      <td><a href={build.url} target="_blank" rel="noreferrer">Hugging Face</a></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        ) : (
          <p class="muted">No builds in this pull. A build is a packaging, not a separate model.</p>
        )}
      </div>

      <div class="panel" id="get-started">
        <h2>Getting started</h2>

        {openCode && (
          <>
            <h3>{openCodeStep}. Use OpenCode (recommended)</h3>
            <p>
              <a href="https://opencode.ai" target="_blank" rel="noreferrer">OpenCode</a> is an open-source coding
              agent for the terminal, desktop, and web. It is the simplest way to run this model, and free models stay
              free through the OpenCode Console provider.
            </p>
            <div class="chips">
              <Pill
                label={`opencode/${openCode.id}`}
                href="/models/?filter=access:opencode"
                tone="tag-status"
                tooltip="The OpenCode Console model ID. Opens models available on OpenCode."
              />
              {openCodeFree && <span class="badge badge-free">free</span>}
            </div>
            <ol class="steps">
              <li>
                <a href="https://opencode.ai" target="_blank" rel="noreferrer">Install OpenCode</a> and open the TUI.
              </li>
              <li>
                Run <code>/connect</code>, choose the OpenCode provider, and paste your API key.
                {openCodeFree && " This model is free for a limited time on this provider."}
              </li>
              <li>Run <code>/models</code> and choose <code>{openCode.id}</code>.</li>
            </ol>
            <pre><code>/connect
/models</code></pre>
            <p class="muted" style="font-size:0.86rem">
              Or set the model directly in <code>opencode.jsonc</code>:
            </p>
            <pre><code>{`{ "model": "${openCodeProvider}/${openCode.id}" }`}</code></pre>
            <a class="mono-small" href="https://opencode.ai/docs/console/models/" target="_blank" rel="noreferrer">
              OpenCode provider setup
            </a>
          </>
        )}

        {cloudflareModel && (
          <>
            <h3>{cloudflareStep}. Run on Cloudflare Workers AI</h3>
            <p>Cloudflare hosts this model. You need a Cloudflare account and a Worker.</p>
            <div class="chips">
              <Pill
                label={cloudflareModel.id}
                href="/models/?filter=access:cloudflare"
                tone="tag-source"
                tooltip="The Cloudflare Workers AI model ID. Opens models available on Cloudflare."
              />
            </div>
            <ol class="steps">
              <li>
                <a href="https://developers.cloudflare.com/workers-ai/get-started/workers-wrangler/" target="_blank" rel="noreferrer">
                  Create a Worker with the Workers AI binding
                </a>.
              </li>
              <li>Call the model from the Worker with the exact ID above.</li>
            </ol>
            <pre><code>{`const reply = await env.AI.run(
  "${cloudflareModel.id}",
  { messages }
)`}</code></pre>
            <p class="muted" style="font-size:0.86rem">
              <a href="https://developers.cloudflare.com/workers-ai/models/" target="_blank" rel="noreferrer">
                Browse all Cloudflare models
              </a>
            </p>
          </>
        )}

        {openRouterModel && (
          <>
            <h3>{openRouterStep}. Use OpenRouter</h3>
            <p>OpenRouter gives you one API key and one endpoint for many hosted models.</p>
            <div class="chips">
              <Pill
                label={openRouterModel.id}
                href={`https://openrouter.ai/${openRouterModel.id}`}
                tone="tag-source"
                tooltip="The OpenRouter model ID."
              />
            </div>
            <ol class="steps">
              <li>
                <a href="https://openrouter.ai" target="_blank" rel="noreferrer">Create an OpenRouter account</a>
                and make an API key.
              </li>
              <li>Send an OpenAI-compatible request with the model ID above.</li>
            </ol>
            <pre><code>{`POST https://openrouter.ai/api/v1/chat/completions
model: "${openRouterModel.id}"`}</code></pre>
            <p class="muted" style="font-size:0.86rem">
              <a href="https://openrouter.ai/docs/quickstart" target="_blank" rel="noreferrer">OpenRouter quickstart</a>
            </p>
          </>
        )}

        <h3>{diyStep}. Run it yourself</h3>
        <p>
          {usage.length > 0
            ? "The Hugging Face model card gives the current install and run commands."
            : "You can run the weights locally when your machine has enough memory and a supported runtime."}
        </p>
        {localRuntimes.length > 0 && (
          <div class="chips">
            {localRuntimes.map((runtime) => (
              <Pill label={runtime} href={tagPath(`access:${runtime}`)} tone="tag-access" tooltip={tagDefinition(`access:${runtime}`)} />
            ))}
          </div>
        )}
        {localRuntimes.length === 0 && usage.length === 0 && (
          <div class="chips">
            <Pill label="no runtime recorded" tone="capability-unknown" tooltip="No local runtime is recorded for this model." />
          </div>
        )}
        {usage.length > 0 && (
          <>
            {usage.map((block) => (
              <pre><code>{block.code}</code></pre>
            ))}
            <p class="muted" style="font-size:0.86rem">
              From the <a href={`https://huggingface.co/${model.access.hugging_face}`} target="_blank" rel="noreferrer">Hugging Face model card</a>.
              Follow it for the current full instructions.
            </p>
          </>
        )}
        <p class="muted" style="font-size:0.86rem;margin-top:0.7rem">
          {model.footprint.params_b == null
            ? "Parameter count is unknown. Check the model card for memory requirements."
            : `Plan for roughly ${memoryLow}–${memoryHigh} GB of weights before KV cache and runtime overhead.`}
        </p>
        {providers.length > 0 && (
          <p class="muted" style="font-size:0.86rem">
            {`${providers.length} hosted providers are listed on models.dev.`}
            {model.access.models_dev && (
              <>
                {" "}
                <a href={model.access.models_dev} target="_blank" rel="noreferrer">See the providers on models.dev</a>.
              </>
            )}
          </p>
        )}
        <a class="mono-small" href={`https://huggingface.co/${model.access.hugging_face}`} target="_blank" rel="noreferrer">
          Get the weights on Hugging Face
        </a>
      </div>

      <div class="panel">
        <h2>Compare</h2>
        <p class="muted" style="font-size:0.9rem">
          Add other models to compare this release against. The comparison opens on its own page.
        </p>
        <ComparePicker currentId={model.id} />
      </div>

    </div>

    <aside id="scorecard">
      {scorecard ? (
        <>
          <div class="panel scorecard-panel scorecard-overall" id="scorecard-overall">
            <h2>Overall score</h2>
            <div class="score-block">
              <strong>{formatIndex(scorecard.overall.score)}</strong>
              <span class="faint">{scorecard.overall.coverage} of 4 axes</span>
            </div>
            <p class="muted" style="font-size:0.84rem">{scorecard.overall.note}</p>
            <ul class="overall-list">
              <li class="overall-row overall-head">
                <span>axis</span>
                <span>weight</span>
                <span>contribution</span>
              </li>
              {overallComponents.map((component) => (
                <li class="overall-row">
                  <CountPill
                    class="overall-pill"
                    label={component.key === "research" ? "citation" : component.key}
                    count={
                      !component.included
                        ? "—"
                        : component.key === "syndication"
                          ? `${formatIndex((component.score ?? 0) / 10)}/10`
                          : formatIndex(component.score)
                    }
                    href={`#scorecard-${component.key}`}
                    tone={`score-${component.key}`}
                    tooltip={
                      component.included
                        ? `${component.label}: ${component.effective_weight}% of the overall score, contributing ${formatIndex(component.contribution)}.`
                        : `${component.label} has no current value, so it is excluded from the overall score. Missing is not zero.`
                    }
                  />
                  <span class="overall-weight">{component.included ? `${component.effective_weight}%` : "—"}</span>
                  <span class="overall-contribution">{component.included ? formatIndex(component.contribution) : "—"}</span>
                </li>
              ))}
            </ul>
            <p class="mono-small muted">
              Base weights: syndication 15, performance 40, openness 30, citation 15. Missing axes are excluded and the
              remaining weights are renormalised.
            </p>
          </div>

          <div class="panel scorecard-panel scorecard-openness" id="scorecard-openness">
            <h2>Openness/Morality</h2>
            <div class="score-block"><strong>{formatIndex(scorecard.openness_morality.score)}</strong></div>
            <ul class="metric-list">
              {scorecard.openness_morality.components.map((component) => (
                <li class="metric-row">
                  <span class="metric-label">{component.label}</span>
                  <a
                    class={`chip ${component.label === "Licence" ? "tag-license" : ""}`.trim()}
                    href={component.label === "Licence" ? tagPath(`license:${component.value}`) : "/#release-terms"}
                    data-tooltip={
                      component.label === "Licence"
                        ? tagDefinition(`license:${component.value}`)
                        : component.label === "Weights"
                          ? "open-weight means the trained weights are downloadable. It does not mean the training data or code are open."
                          : component.label === "Training data"
                            ? "open means the data is published. documented means it is described but not released. unknown means unchecked, not closed."
                            : "open means the training code is published. documented means it is described but not released. unknown means unchecked, not closed."
                    }
                  >
                    {component.value}
                  </a>
                  <span class="metric-points">{component.points}/{component.max}</span>
                </li>
              ))}
            </ul>
            <p class="muted" style="font-size:0.84rem">{scorecard.openness_morality.note}</p>
            <p class="mono-small muted">
              Tier:
              <a
                href="/#release-terms"
                data-tooltip={tierDescription(scorecard.openness_morality.tier)}
              >
                {scorecard.openness_morality.tier}
              </a>
            </p>
          </div>

          <div class="panel scorecard-panel scorecard-performance" id="scorecard-performance">
            <h2>Performance/Intelligence</h2>
            <div class="score-block">
              <strong class={scorecard.performance.score == null ? "unmeasured" : ""}>{formatIndex(scorecard.performance.score)}</strong>
              {scorecard.performance.score == null && <span class="faint">Not measured</span>}
            </div>
            <p class="muted" style="font-size:0.84rem">{scorecard.performance.note}</p>
            {scorecard.performance.benchmarks.length > 0 && (
              <ul class="benchmark-list">
                {scorecard.performance.benchmarks.map((benchmark) => (
                  <li>
                    <span>{benchmark.name}</span>
                    <span class="mono-small">{formatIndex(benchmark.score)}{benchmark.self_reported ? " *" : ""}</span>
                  </li>
                ))}
              </ul>
            )}
            {scorecard.performance.own_benchmarks.length > 0 && (
              <details class="own-evidence">
                <summary>Own evidence from this release</summary>
                <ul class="benchmark-list">
                  {scorecard.performance.own_benchmarks.map((benchmark) => (
                    <li>
                      <span>{benchmark.name}</span>
                      <span class="mono-small">{formatIndex(benchmark.score)}{benchmark.self_reported ? " *" : ""}</span>
                    </li>
                  ))}
                </ul>
              </details>
            )}
            <p class="mono-small muted">
              {scorecard.performance.basis ? `${scorecard.performance.basis} basis` : "No basis"}
              {scorecard.performance.match === "base" ? " · base-model match" : ""}
              {scorecard.performance.as_of ? ` · ${formatDate(scorecard.performance.as_of)}` : ""}
            </p>
            {scorecard.performance.source && (
              <a class="mono-small" href={scorecard.performance.source} target="_blank" rel="noreferrer">Source</a>
            )}
          </div>

          <div class="panel scorecard-panel scorecard-research" id="scorecard-research">
            <h2>Citation/Research</h2>
            <div class="score-block">
              <strong class={scorecard.research_citation.score == null ? "unmeasured" : ""}>{formatIndex(scorecard.research_citation.score)}</strong>
              {scorecard.research_citation.score == null && <span class="faint">Not measured</span>}
            </div>
            <p class="muted" style="font-size:0.84rem">{scorecard.research_citation.note}</p>
            {scorecard.research_citation.benchmarks.length > 0 && (
              <ul class="benchmark-list">
                {scorecard.research_citation.benchmarks.map((benchmark) => (
                  <li>
                    <span>{benchmark.name}</span>
                    <span class="mono-small">{formatIndex(benchmark.score)}</span>
                  </li>
                ))}
              </ul>
            )}
            <p class="mono-small muted">Citation accuracy: {scorecard.research_citation.citation}</p>
            {scorecard.research_citation.source && (
              <a class="mono-small" href={scorecard.research_citation.source} target="_blank" rel="noreferrer">Source</a>
            )}
          </div>

          <div class="panel scorecard-panel scorecard-syndication" id="scorecard-syndication">
            <h2>Syndication</h2>
            <div class="score-block">
              <strong>{scorecard.syndication.score}</strong><span class="faint">/{scorecard.syndication.max}</span>
              <a
                class={`badge ${bandClass(scorecard.syndication.band)}`}
                href={`/models/?band=${scorecard.syndication.band}`}
                data-tooltip="Filter the model index to this syndication band. The band groups independent listings; it is not a quality grade."
              >
                {scorecard.syndication.band.replaceAll("-", " ")}
              </a>
            </div>
            <p class="muted" style="font-size:0.84rem">{scorecard.syndication.note}</p>
            <ul class="source-list">
              {model.syndication.sources.map((source) => (
                <li>
                  <a href={source.url} target="_blank" rel="noreferrer">{source.id}</a>
                  <span class="weight">+{source.weight}{source.self ? " self" : ""}</span>
                </li>
              ))}
            </ul>
          </div>
        </>
      ) : (
        <div class="panel">
          <h2>Scorecard</h2>
          <p class="muted">No scorecard entry for this model yet. Missing is not zero.</p>
        </div>
      )}

    </aside>
  </section>
</Base>
