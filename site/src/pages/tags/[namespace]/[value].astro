---
import Base from "../../../layouts/Base.astro"
import CountPill from "../../../components/CountPill.astro"
import TagChips from "../../../components/TagChips.astro"
import {
  allTagPairs,
  getIndex,
  formatContextCount,
  getTags,
  metricForTask,
  modelHref,
  scorecardAxes,
  sortTags,
  tagLabel,
} from "../../../lib/data"

export function getStaticPaths() {
  const vocabulary = getTags()
  const tags = new Set<string>()
  for (const [namespace, entry] of Object.entries(vocabulary.namespaces)) {
    for (const value of Object.keys(entry.values)) tags.add(`${namespace}:${value}`)
  }
  for (const { tag } of allTagPairs(getIndex())) tags.add(tag)
  return [...tags].map((tag) => {
    const [namespace, ...rest] = tag.split(":")
    const value = rest.join(":")
    return { params: { namespace, value }, props: { tag } }
  })
}

interface Props {
  tag: string
}

const { tag } = Astro.props
const index = getIndex()
const vocabulary = getTags()
const [namespace, ...rest] = tag.split(":")
const value = rest.join(":")
const definition = vocabulary.namespaces[namespace!]?.values?.[value]
const task = namespace === "task" ? value : ""
const tagged = index.models.filter((model) => model.tags.includes(tag))
const metric = task ? metricForTask(tagged, task) : null
const hasTaskMetric = metric != null && metric.label !== "Performance"
const defaultSort = tagged.some((model) => model.scorecard?.performance.score != null) ? "performance" : "syndication"

const models = [...tagged].sort((a, b) => {
  const av = a.scorecard?.performance.score ?? null
  const bv = b.scorecard?.performance.score ?? null
  if (av == null && bv != null) return 1
  if (bv == null && av != null) return -1
  if (av != null && bv != null && av !== bv) return bv - av
  return b.score - a.score || a.name.localeCompare(b.name)
})

const allTags = sortTags([...new Set(models.flatMap((model) => model.tags))])
const axis = (model: (typeof models)[number], key: "openness" | "performance" | "research" | "syndication") =>
  scorecardAxes(model).find((entry) => entry.key === key)?.value ?? null
const scorecardTone = (key: string) => `score-${key}`
const scorecardTip = (key: string) =>
  key === "overall"
    ? "Overall score: weighted mean of the available axes. Missing axes are excluded, not zero."
    : key === "openness"
    ? "Openness/Morality: what the release gives back. Computed from current release terms."
    : key === "performance"
      ? "Performance/Intelligence: current measured performance on the model's task."
      : key === "research"
        ? "Citation/Research: current research benchmarks. Citation accuracy is separate."
        : "Syndication: independent listings, not quality."
---

<Base
  title={`${tagLabel(tag)} — ${namespace}`}
  description={`Models tagged ${tag}. ${definition ?? ""}`}
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow"><a href="/tags/">Tags</a> / {namespace}</p>
      <h1>{tagLabel(tag)}</h1>
      <p class="lede">{definition ?? "A tag in the catalogue."}</p>
      <p class="mono-small muted">
        {tag} · {models.length} models
        {hasTaskMetric ? ` · ${metric!.label} is shown when available` : ""}
      </p>
    </div>
  </section>

  <section class="wrap" style="padding:1.6rem 0 3rem">
    {models.length === 0 ? (
      <div class="empty" style="text-align:left">
        <p class="eyebrow">Coverage gap</p>
        <h2 style="margin-bottom:0.5rem">Nothing is tagged {tag} yet.</h2>
        <p>
          The tag is defined in the vocabulary, but no root model in the current pull carries it. This is a coverage
          gap, not a filter result. The catalogue does not add a model just to fill the tag.
        </p>
        <div class="flex wrap-gap">
          <a class="button" href="/models/">Browse all models</a>
          <a class="button secondary" href="/tags/">Browse all tags</a>
        </div>
      </div>
    ) : (
      <>
    <div class="filters" style="--filter-cols:minmax(12rem,1.4fr) repeat(2,minmax(9rem,0.7fr)) minmax(15rem,1.2fr)">
      <div class="field">
        <label for="q">Search</label>
        <input id="q" type="search" placeholder="Name, organisation, or summary" autocomplete="off" />
      </div>
      <div class="field">
        <label>Filter <span class="field-hint">all required</span></label>
        <details class="combo" id="filter-combo">
          <summary><span id="filter-summary">All tags</span></summary>
          <div class="combo-panel">
            {allTags.map((available) => (
              <label class="combo-option">
                <input type="checkbox" name="filter" value={available} />
                <span>{available}</span>
              </label>
            ))}
          </div>
        </details>
      </div>
      <div class="field">
        <label>Options <span class="field-hint">any required</span></label>
        <details class="combo" id="options-combo">
          <summary><span id="options-summary">Any tag</span></summary>
          <div class="combo-panel">
            {allTags.map((available) => (
              <label class="combo-option">
                <input type="checkbox" name="options" value={available} />
                <span>{available}</span>
              </label>
            ))}
          </div>
        </details>
      </div>
      <div class="field">
        <label for="sort">Sort</label>
        <div class="sort-control">
          <select id="sort">
            <option value="overall">Overall score</option>
            <option value="syndication">Syndication</option>
            <option value="performance">Performance/Intelligence</option>
            <option value="openness">Openness/Morality</option>
            <option value="research">Citation/Research</option>
            <option value="released">Release date</option>
            <option value="name">Name</option>
            {hasTaskMetric && <option value="task">{metric!.label}</option>}
          </select>
          <button id="order" class="order-toggle" type="button" aria-label="Reverse the sort order">
            Best first
          </button>
        </div>
      </div>
    </div>

    <div class="filter-meta">
      <span id="count">Showing {models.length} of {models.length} models</span>
      <span class="faint" id="sort-note">
        Sorted by Performance/Intelligence, best first. Missing scores sort last.
      </span>
    </div>

    <div
      class="list"
      id="tag-list"
      style="--list-cols:minmax(12rem, 0.9fr) minmax(18rem, 2.1fr) minmax(10.5rem, auto)"
      data-direction={metric?.direction ?? "higher"}
      data-default-sort={defaultSort}
    >
      {models.map((model) => {
        const axes = scorecardAxes(model)
        const taskValue = hasTaskMetric && model.task_performance?.task === task ? model.task_performance : null
        return (
          <div
            class="list-row"
            data-name={`${model.name} ${model.organization} ${model.summary}`.toLowerCase()}
            data-tags={model.tags.join(" ")}
            data-overall={model.scorecard?.overall.score ?? -1}
            data-openness={axis(model, "openness") ?? -1}
            data-performance={axis(model, "performance") ?? -1}
            data-research={axis(model, "research") ?? -1}
            data-score={axis(model, "syndication") ?? 0}
            data-released={model.released ?? ""}
            data-task={taskValue?.value ?? -1}
            data-task-direction={metric?.direction ?? "higher"}
          >
            <div>
              <a class="row-title" href={modelHref(model.id)}><h3>{model.name}</h3></a>
              <p class="mono-small">{model.organization}</p>
            </div>
            <div class="list-description">
              <p>{model.summary || "No description on the model card."}</p>
              <TagChips tags={model.tags} showNamespace>
                {model.context_tokens && (
                  <a
                    class="chip meta-context"
                    href={`${modelHref(model.id)}#capabilities`}
                    data-tooltip="The model's maximum context window."
                  >
                    context: {formatContextCount(model.context_tokens)}
                  </a>
                )}
                {model.builds > 0 && (
                  <CountPill
                    label="builds"
                    count={model.builds}
                    href={`${modelHref(model.id)}#builds`}
                    tone="meta-builds"
                    tooltip="A build is packaging, not a new model. It inherits the base task and terms."
                  />
                )}
              </TagChips>
            </div>
            <div class="scorecard-mini">
              {hasTaskMetric && (
                <CountPill
                  label={metric!.label}
                  count={taskValue ? `${taskValue.value}${taskValue.unit}` : "—"}
                  href={`${modelHref(model.id)}#scorecard-performance`}
                  tone="capability"
                  tooltip={taskValue ? taskValue.note : "No current task score is recorded."}
                />
              )}
              {axes.map((entry) => (
                <CountPill
                  label={entry.label}
                  count={entry.display}
                  href={`${modelHref(model.id)}#scorecard-${entry.key}`}
                  tone={scorecardTone(entry.key)}
                  tooltip={scorecardTip(entry.key)}
                />
              ))}
            </div>
          </div>
        )
      })}
    </div>

    <div class="empty hidden" id="empty">No model matches those filters.</div>
      </>
    )}
  </section>

  <script define:vars={{ defaultSort }}>
    const q = document.getElementById("q")
    const filterCombo = document.getElementById("filter-combo")
    const optionsCombo = document.getElementById("options-combo")
    const filterSummary = document.getElementById("filter-summary")
    const optionsSummary = document.getElementById("options-summary")
    const filterChecks = [...document.querySelectorAll("#filter-combo input[type=checkbox]")]
    const optionChecks = [...document.querySelectorAll("#options-combo input[type=checkbox]")]
    const sort = document.getElementById("sort")
    const order = document.getElementById("order")
    const count = document.getElementById("count")
    const note = document.getElementById("sort-note")
    const empty = document.getElementById("empty")
    const list = document.getElementById("tag-list")
    const rows = [...document.querySelectorAll("#tag-list .list-row")]
    const params = new URLSearchParams(location.search)
    let orderMode = params.get("order") === "worst" ? "worst" : "best"
    if (q && params.get("q")) q.value = params.get("q")
    if (sort && params.get("sort")) sort.value = params.get("sort")

    const selectedFilter = (params.get("filter") ?? "").split(",").filter(Boolean)
    const selectedOptions = (params.get("options") ?? "").split(",").filter(Boolean)
    for (const box of filterChecks) box.checked = selectedFilter.includes(box.value)
    for (const box of optionChecks) box.checked = selectedOptions.includes(box.value)

    function selected(boxes) {
      return boxes.filter((box) => box.checked).map((box) => box.value)
    }

    function updateSummaries() {
      const filterCount = selected(filterChecks).length
      const optionCount = selected(optionChecks).length
      if (filterSummary) filterSummary.textContent = filterCount ? `${filterCount} selected` : "All tags"
      if (optionsSummary) optionsSummary.textContent = optionCount ? `${optionCount} selected` : "Any tag"
    }

    function setOrderLabel() {
      if (!order) return
      const mode = sort?.value ?? defaultSort
      if (mode === "name") order.textContent = orderMode === "best" ? "A–Z" : "Z–A"
      else if (mode === "released") order.textContent = orderMode === "best" ? "Newest" : "Oldest"
      else if (mode === "task") order.textContent = orderMode === "best" ? "Best first" : "Worst first"
      else order.textContent = orderMode === "best" ? "High first" : "Low first"
    }

    function number(row, key) {
      const raw = row.dataset[key]
      if (!raw) return null
      const value = Number(raw)
      return Number.isFinite(value) && value >= 0 ? value : null
    }

    function compare(a, b, key, direction) {
      const av = number(a, key)
      const bv = number(b, key)
      if (av == null && bv == null) return 0
      if (av == null) return 1
      if (bv == null) return -1
      if (av === bv) return 0
      const diff = av - bv
      const best = direction === "lower" ? diff : -diff
      return orderMode === "best" ? best : -best
    }

    function sortRows(mode) {
      const sorted = [...rows].sort((a, b) => {
        if (mode === "name") {
          const diff = (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "")
          return orderMode === "best" ? diff : -diff
        }
        if (mode === "released") {
          const av = a.dataset.released ?? ""
          const bv = b.dataset.released ?? ""
          if (!av && !bv) return 0
          if (!av) return 1
          if (!bv) return -1
          const diff = av.localeCompare(bv)
          return orderMode === "best" ? -diff : diff
        }
        if (mode === "task") {
          const direction = a.dataset.taskDirection ?? "higher"
          return compare(a, b, "task", direction) || (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "")
        }
        const key =
          mode === "overall"
            ? "overall"
            : mode === "openness"
              ? "openness"
              : mode === "performance"
                ? "performance"
                : mode === "research"
                  ? "research"
                  : "score"
        return compare(a, b, key, "higher") || (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "")
      })
      for (const row of sorted) list?.append(row)
    }

    function apply() {
      const search = q?.value.trim().toLowerCase() ?? ""
      const required = selected(filterChecks)
      const optional = selected(optionChecks)
      let visible = 0
      for (const row of rows) {
        const tags = row.dataset.tags?.split(" ") ?? []
        const matches =
          (!search || row.dataset.name?.includes(search)) &&
          (required.length === 0 || required.every((value) => tags.includes(value))) &&
          (optional.length === 0 || optional.some((value) => tags.includes(value)))
        row.classList.toggle("hidden", !matches)
        if (matches) visible++
      }
      if (count) count.textContent = `Showing ${visible} of ${rows.length} models`
      empty?.classList.toggle("hidden", visible > 0)
      updateSummaries()

      const mode = sort?.value ?? defaultSort
      setOrderLabel()
      sortRows(mode)

      const labels = {
        overall: "overall score",
        performance: "Performance/Intelligence",
        openness: "Openness/Morality",
        research: "Citation/Research",
        syndication: "independent listings",
        released: "release date",
        name: "name",
        task: "task metric",
      }
      if (note) {
        const label = labels[mode] ?? mode
        const direction =
          mode === "name"
            ? orderMode === "best"
              ? "A–Z"
              : "Z–A"
            : mode === "released"
              ? orderMode === "best"
                ? "newest first"
                : "oldest first"
              : orderMode === "best"
                ? "best first"
                : "worst first"
        note.textContent = `Sorted by ${label}, ${direction}. Missing scores sort last.`
      }

      const next = new URLSearchParams()
      if (search) next.set("q", search)
      if (required.length > 0) next.set("filter", required.join(","))
      if (optional.length > 0) next.set("options", optional.join(","))
      if (mode !== defaultSort) next.set("sort", mode)
      if (orderMode !== "best") next.set("order", orderMode)
      const query = next.toString()
      history.replaceState(null, "", query ? `?${query}` : location.pathname)
    }

    q?.addEventListener("input", apply)
    for (const box of [...filterChecks, ...optionChecks]) box.addEventListener("change", apply)
    sort?.addEventListener("input", apply)
    order?.addEventListener("click", () => {
      orderMode = orderMode === "best" ? "worst" : "best"
      apply()
    })
    document.addEventListener("click", (event) => {
      for (const combo of [filterCombo, optionsCombo]) {
        if (combo && !combo.contains(event.target)) combo.removeAttribute("open")
      }
    })
    apply()
  </script>
</Base>
