---
import Base from "../../layouts/Base.astro"
import CountPill from "../../components/CountPill.astro"
import { allTagPairs, getIndex, getTags, tagLabel, tagPath } from "../../lib/data"

const index = getIndex()
const vocabulary = getTags()
const pairCounts = new Map(allTagPairs(index).map(({ tag, count }) => [tag, count]))
const grouped = new Map<string, Array<{ tag: string; value: string; count: number; definition?: string }>>()

for (const [namespace, entry] of Object.entries(vocabulary.namespaces)) {
  if (namespace === "org" || namespace === "source") continue
  for (const [value, definition] of Object.entries(entry.values)) {
    const tag = `${namespace}:${value}`
    const list = grouped.get(namespace) ?? []
    list.push({ tag, value, count: pairCounts.get(tag) ?? 0, definition })
    grouped.set(namespace, list)
  }
}
for (const { tag, count } of allTagPairs(index)) {
  const [namespace, ...rest] = tag.split(":")
  if (namespace === "org" || namespace === "source") continue
  if (grouped.get(namespace!)?.some((entry) => entry.tag === tag)) continue
  const list = grouped.get(namespace!) ?? []
  list.push({ tag, value: rest.join(":"), count, definition: vocabulary.namespaces[namespace!]?.values?.[rest.join(":")] })
  grouped.set(namespace!, list)
}

const namespaceOrder = ["task", "domain", "context", "modality", "runtime", "language", "license", "family", "status", "relation", "source"]
const namespaces = [...grouped.entries()].sort(
  (a, b) => namespaceOrder.indexOf(a[0]) - namespaceOrder.indexOf(b[0]) || a[0].localeCompare(b[0]),
)
---

<Base title="Tags" description="Browse the catalogue by task, domain, runtime, language, licence, and context.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Classification</p>
      <h1>Tags</h1>
      <p class="lede">
        Tags are additive. A model can carry several tasks, modalities, runtimes, and languages. There is no single
        category per model.
      </p>
    </div>
  </section>

  <section class="wrap" style="padding:2rem 0 3rem">
    {namespaces.map(([namespace, values]) => (
      <div class="panel">
        <div class="flex justify-between items-center wrap-gap">
          <h2 style="margin-bottom:0">{namespace}</h2>
          <span class="faint mono-small">{values.length} values</span>
        </div>
        <p class="muted" style="font-size:0.9rem;margin-top:0.4rem">
          {vocabulary.namespaces[namespace]?.definition ?? "A tag namespace."}
        </p>
        <div class="flex wrap-gap">
          {values
            .sort((a, b) => b.count - a.count || a.value.localeCompare(b.value))
            .map(({ tag, value, count, definition }) => (
              <CountPill
                label={tagLabel(tag)}
                count={count}
                href={tagPath(tag)}
                tone={namespace === "task" ? "sage" : namespace === "domain" ? "sky" : namespace === "context" ? "ochre" : "plum"}
              />
            ))}
        </div>
      </div>
    ))}
  </section>
</Base>
