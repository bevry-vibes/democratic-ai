---
import Base from "../layouts/Base.astro"
import ModelList from "../components/ModelList.astro"
import TagIndex from "../components/TagIndex.astro"
import ThesisContent from "../components/ThesisContent.astro"
import MethodContent from "../components/MethodContent.astro"
import { getIndex, sortTags, taskCounts } from "../lib/data"

const index = getIndex()
const models = [...index.models].sort(
  (a, b) => (b.scorecard?.overall.score ?? -1) - (a.scorecard?.overall.score ?? -1) || a.name.localeCompare(b.name),
)
const tasks = taskCounts(index)
const allTags = sortTags([...new Set(models.flatMap((model) => model.tags))])
---

<Base
  title="Democratic AI"
  description="A catalogue of reciprocal AI models, judged by what they give back: open weights, open data, open code, and reuse terms."
>
  <section class="hero home-hero">
    <div class="wrap">
      <div>
        <p class="eyebrow">The Democratic AI catalogue</p>
        <h1>AI that takes from the commons should give back.</h1>
        <p class="lede">
          Democratic AI is a working catalogue of models judged by what they return, not only by what they can do.
          Open weights are a real return. Open data and open code make the gift reproducible. Read the scorecard,
          then choose a model for the job.
        </p>
        <p class="hero-meta">
          <a href="#models">{index.models.length} models</a> · <a href="#tags">{tasks.length} task tags</a> · last index{" "}
          {index.generated_at.slice(0, 10)}
        </p>
      </div>
    </div>
  </section>

  <section class="section rule-top" id="models">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">The catalogue</p>
          <h2>Models</h2>
        </div>
      </div>
      <div class="models-intro">
        <p class="muted">
          All {index.models.length} models, strongest current overall score first. Scroll the list to load the rest.
        </p>
        <a href="/models/">Open the full index →</a>
      </div>
      <div class="filters" style="--filter-cols:minmax(12rem,1.2fr) repeat(2,minmax(8rem,0.7fr)) minmax(18rem,1.6fr)">
        <div class="field">
          <label for="q">Search</label>
          <input id="q" type="search" placeholder="Name, organisation, or summary" autocomplete="off" />
        </div>
        <div class="field">
          <label>Filter <span class="field-hint">all required</span></label>
          <details class="combo" id="filter-combo">
            <summary><span id="filter-summary">All tags</span></summary>
            <div class="combo-panel">
              {allTags.map((available) => (
                <label class="combo-option">
                  <input type="checkbox" name="filter" value={available} />
                  <span>{available}</span>
                </label>
              ))}
            </div>
          </details>
        </div>
        <div class="field">
          <label>Options <span class="field-hint">any required</span></label>
          <details class="combo" id="options-combo">
            <summary><span id="options-summary">Any tag</span></summary>
            <div class="combo-panel">
              {allTags.map((available) => (
                <label class="combo-option">
                  <input type="checkbox" name="options" value={available} />
                  <span>{available}</span>
                </label>
              ))}
            </div>
          </details>
        </div>
        <div class="field">
          <label for="sort">Sort</label>
          <div class="sort-control">
            <select id="sort">
              <option value="overall">Overall score</option>
              <option value="syndication">Syndication</option>
              <option value="performance">Performance/Intelligence</option>
              <option value="openness">Openness/Morality</option>
              <option value="research">Citation/Research</option>
              <option value="released">Release date</option>
              <option value="name">Name</option>
            </select>
            <button id="order" class="order-toggle" type="button" aria-label="Reverse the sort order">
              High first
            </button>
          </div>
        </div>
      </div>

      <div class="filter-meta">
        <span id="count">Showing {models.length} models</span>
        <span class="faint" id="sort-note">Sorted by overall score, high first</span>
      </div>

      <div class="home-model-scroll" data-home-models>
        <ModelList models={models} listId="home-model-list" lazyFrom={14} />
      </div>

      <div class="empty hidden" id="empty">
        No model matches those filters. Try a broader task or clear the search.
      </div>

      <div class="home-more">
        <span>{index.models.length} models in the catalogue, sorted by overall score.</span>
        <a href="/models/">See all models →</a>
      </div>
    </div>
  </section>

  <section class="section rule-top" id="tags">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Classification</p>
          <h2>Tags</h2>
        </div>
      </div>
      <p class="lede" style="margin-bottom:1.4rem">
        Tags are additive. A model can carry several tasks, modalities, runtimes, and languages. There is no single
        category per model. Open any tag to see the models that carry it.
      </p>
      <TagIndex />
    </div>
  </section>

  <section class="section rule-top" id="runtime">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Runtime</p>
          <h2>Where to run it</h2>
        </div>
      </div>
      <p class="lede" style="margin-bottom:1.4rem">
        Start with a hosted harness. OpenCode is the recommended path. Cloudflare Workers AI and OpenRouter are also
        direct options. Each model page shows the exact model ID and steps for the providers that carry it.
      </p>
      <div class="runtime-grid">
        <div class="panel runtime-card">
          <p class="eyebrow">Recommended harness</p>
          <h3>OpenCode</h3>
          <p>
            An open-source coding agent. It can run the models in this catalogue, including free entries, with one
            provider connection.
          </p>
          <pre><code>/connect
/models</code></pre>
          <p class="muted runtime-note">
            Run <code>/connect</code> in the TUI, choose a provider, and paste the API key. Run <code>/models</code>
            to pick the model. Free models are marked on each model page.
          </p>
          <a class="button secondary" href="https://opencode.ai" target="_blank" rel="noreferrer">OpenCode →</a>
        </div>
        <div class="panel runtime-card">
          <p class="eyebrow">Edge runtime</p>
          <h3>Cloudflare Workers AI</h3>
          <p>
            Run the model from a Worker with the Workers AI binding. No separate host, key, or container is needed.
          </p>
          <pre><code>{`const reply = await env.AI.run(
  "@cf/provider/model",
  { messages }
)`}</code></pre>
          <p class="muted runtime-note">
            The exact <code>@cf/…</code> model ID is shown on the model page when Cloudflare lists it.
          </p>
          <a class="button secondary" href="https://developers.cloudflare.com/workers-ai/" target="_blank" rel="noreferrer">
            Workers AI docs →
          </a>
        </div>
        <div class="panel runtime-card">
          <p class="eyebrow">One API, many models</p>
          <h3>OpenRouter</h3>
          <p>
            A single API key and endpoint for many hosted models. Useful when you want to switch models without
            changing your client.
          </p>
          <pre><code>{`BASE_URL=https://openrouter.ai/api/v1`}</code></pre>
          <p class="muted runtime-note">
            Send an OpenAI-compatible request to <code>/chat/completions</code>. The exact OpenRouter model ID is
            shown on the model page when OpenRouter lists it.
          </p>
          <a class="button secondary" href="https://openrouter.ai" target="_blank" rel="noreferrer">OpenRouter →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section rule-top" id="thesis">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">The argument</p>
          <h2>The commons is the input. Reciprocity is the test.</h2>
        </div>
      </div>
      <p class="lede">
        Every capable model is built from human work: books, code, images, speech, conversation, and the record of
        everyone who came before. The question is not whether a model learned from the commons. It did. The question
        is what it gives back.
      </p>
      <ThesisContent />
    </div>
  </section>

  <section class="section rule-top" id="method">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Method</p>
          <h2>What counts, and how we check it.</h2>
        </div>
      </div>
      <p class="lede">
        Democratic AI is reciprocal AI. Every model learns from the commons. This catalogue records what a release
        gives back, and whether independent registries picked it up.
      </p>
      <MethodContent />
    </div>
  </section>

  <section class="section rule-top" id="api">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">For agents</p>
          <h2>Use the API</h2>
        </div>
        <a href="/data/">API and schema →</a>
      </div>
      <div class="agent-api">
        <div><code>GET /api/v1/index.json</code><p>Compact model rows, tags, and scorecard.</p></div>
        <div><code>GET /api/v1/models/&lt;id&gt;.json</code><p>The full model record.</p></div>
        <div><code>GET /api/v1/tags.json</code><p>The tag vocabulary.</p></div>
      </div>
    </div>
  </section>

  <script>
    const q = document.getElementById("q") as HTMLInputElement | null
    const filterCombo = document.getElementById("filter-combo")
    const optionsCombo = document.getElementById("options-combo")
    const filterSummary = document.getElementById("filter-summary")
    const optionsSummary = document.getElementById("options-summary")
    const filterChecks = [...document.querySelectorAll<HTMLInputElement>("#filter-combo input[type=checkbox]")]
    const optionChecks = [...document.querySelectorAll<HTMLInputElement>("#options-combo input[type=checkbox]")]
    const sort = document.getElementById("sort") as HTMLSelectElement | null
    const order = document.getElementById("order")
    const count = document.getElementById("count")
    const note = document.getElementById("sort-note")
    const empty = document.getElementById("empty")
    const scroller = document.querySelector<HTMLElement>("[data-home-models]")
    const rows = [...document.querySelectorAll<HTMLElement>("#home-model-list .list-row")]
    const CHUNK = 18
    let cursor = 0

    const params = new URLSearchParams(location.search)
    let orderMode = params.get("order") === "worst" ? "worst" : "best"
    if (q && params.get("q")) q.value = params.get("q")!
    if (sort && params.get("sort")) sort.value = params.get("sort")!
    for (const box of filterChecks) box.checked = (params.get("filter") ?? "").split(",").filter(Boolean).includes(box.value)
    for (const box of optionChecks) box.checked = (params.get("options") ?? "").split(",").filter(Boolean).includes(box.value)

    function selected(boxes: HTMLInputElement[]): string[] {
      return boxes.filter((box) => box.checked).map((box) => box.value)
    }

    function updateSummaries(): void {
      const filterCount = selected(filterChecks).length
      const optionCount = selected(optionChecks).length
      if (filterSummary) filterSummary.textContent = filterCount ? `${filterCount} selected` : "All tags"
      if (optionsSummary) optionsSummary.textContent = optionCount ? `${optionCount} selected` : "Any tag"
    }

    function setOrderLabel(): void {
      if (!order) return
      const mode = sort?.value ?? "overall"
      if (mode === "name") order.textContent = orderMode === "best" ? "A–Z" : "Z–A"
      else if (mode === "released") order.textContent = orderMode === "best" ? "Newest" : "Oldest"
      else order.textContent = orderMode === "best" ? "High first" : "Low first"
    }

    function number(row: HTMLElement, key: string): number | null {
      const raw = row.dataset[key]
      if (!raw) return null
      const value = Number(raw)
      return Number.isFinite(value) && value >= 0 ? value : null
    }

    function compare(a: HTMLElement, b: HTMLElement, key: string): number {
      const av = number(a, key)
      const bv = number(b, key)
      if (av == null && bv == null) return 0
      if (av == null) return 1
      if (bv == null) return -1
      if (av === bv) return 0
      const best = -1 * (av - bv)
      return orderMode === "best" ? best : -best
    }

    function markLast(): void {
      const visible = rows.filter((row) => !row.classList.contains("lazy-row") && !row.classList.contains("hidden"))
      for (const row of rows) row.classList.remove("last-visible")
      visible.at(-1)?.classList.add("last-visible")
    }

    function reveal(): void {
      const lazy = rows.filter((row) => row.classList.contains("lazy-row"))
      if (cursor >= lazy.length) return
      for (const row of lazy.slice(cursor, cursor + CHUNK)) row.classList.remove("lazy-row")
      cursor += CHUNK
      markLast()
    }

    function fill(): void {
      if (!scroller) return
      while (rows.some((row) => row.classList.contains("lazy-row")) && scroller.scrollHeight <= scroller.clientHeight + 4) reveal()
      markLast()
    }

    function maybeReveal(): void {
      if (!scroller) return
      if (scroller.scrollTop + scroller.clientHeight >= scroller.scrollHeight - 240) reveal()
    }

    function apply(fromUser = false): void {
      const search = q?.value.trim().toLowerCase() ?? ""
      const required = selected(filterChecks)
      const optional = selected(optionChecks)
      let visible = 0
      for (const row of rows) {
        const tags = row.dataset.tags?.split(" ") ?? []
        const matches =
          (!search || row.dataset.name?.includes(search)) &&
          (required.length === 0 || required.every((value) => tags.includes(value))) &&
          (optional.length === 0 || optional.some((value) => tags.includes(value)))
        row.classList.toggle("hidden", !matches)
        if (matches) {
          visible++
          if (fromUser) row.classList.remove("lazy-row")
        }
      }
      if (count) {
        count.textContent = fromUser
          ? `Showing ${visible} of ${rows.length} models`
          : `${rows.length} models · scroll to load more`
      }
      empty?.classList.toggle("hidden", visible > 0)
      updateSummaries()

      const mode = sort?.value ?? "overall"
      setOrderLabel()
      const sorted = [...rows].sort((a, b) => {
        if (mode === "name") {
          const diff = (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "")
          return orderMode === "best" ? diff : -diff
        }
        if (mode === "released") {
          const av = a.dataset.released ?? ""
          const bv = b.dataset.released ?? ""
          if (!av && !bv) return 0
          if (!av) return 1
          if (!bv) return -1
          const diff = av.localeCompare(bv)
          return orderMode === "best" ? -diff : diff
        }
        const key =
          mode === "overall"
            ? "overall"
            : mode === "openness"
              ? "openness"
              : mode === "performance"
                ? "performance"
                : mode === "research"
                  ? "research"
                  : "score"
        return compare(a, b, key) || (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "")
      })
      for (const row of sorted) document.getElementById("home-model-list")?.append(row)

      if (note) {
        const labels: Record<string, string> = {
          overall: "overall score",
          syndication: "independent listings",
          performance: "Performance/Intelligence",
          openness: "Openness/Morality",
          research: "Citation/Research",
          released: "release date",
          name: "name",
        }
        const label = labels[mode] ?? mode
        const direction =
          mode === "name"
            ? orderMode === "best"
              ? "A–Z"
              : "Z–A"
            : mode === "released"
              ? orderMode === "best"
                ? "newest first"
                : "oldest first"
              : orderMode === "best"
                ? "high first"
                : "low first"
        note.textContent = `Sorted by ${label}, ${direction}. Missing scores sort last.`
      }

      markLast()

      const next = new URLSearchParams()
      if (search) next.set("q", search)
      if (required.length > 0) next.set("filter", required.join(","))
      if (optional.length > 0) next.set("options", optional.join(","))
      if (mode !== "overall") next.set("sort", mode)
      if (orderMode !== "best") next.set("order", orderMode)
      const query = next.toString()
      history.replaceState(null, "", query ? `?${query}` : location.pathname)
    }

    q?.addEventListener("input", () => apply(true))
    for (const box of [...filterChecks, ...optionChecks]) box.addEventListener("change", () => apply(true))
    sort?.addEventListener("input", () => apply(true))
    order?.addEventListener("click", () => {
      orderMode = orderMode === "best" ? "worst" : "best"
      apply(true)
    })
    scroller?.addEventListener("scroll", maybeReveal, { passive: true })
    document.addEventListener("click", (event) => {
      for (const combo of [filterCombo, optionsCombo]) {
        if (combo && !combo.contains(event.target as Node)) combo.removeAttribute("open")
      }
    })
    apply(false)
    fill()
  </script>
</Base>
