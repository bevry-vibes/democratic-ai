---
import Base from "../layouts/Base.astro"
import CountPill from "../components/CountPill.astro"
import TagChips from "../components/TagChips.astro"
import ComparePicker from "../components/ComparePicker.astro"
import { getIndex, tagDefinition, tagLabel, tagPath, taskCounts, topModels } from "../lib/data"

const index = getIndex()
const top = topModels(index, 6)
const tasks = taskCounts(index)
---

<Base
  title="Democratic AI"
  description="A catalogue of reciprocal AI models, tagged for the job you need, with a current scorecard and open JSON."
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">The Democratic AI catalogue</p>
      <h1>Find a model by job. Read what it gives back.</h1>
      <p class="lede">
        A catalogue of reciprocal AI. Start with a task, compare the current scorecard, and use the JSON without an
        account.
      </p>
      <p class="hero-meta">
        {index.models.length} models · {tasks.length} task tags · last index {index.generated_at.slice(0, 10)}
      </p>
    </div>
  </section>

  <section class="section rule-top">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Models</p>
          <h2>Strongest overall scores</h2>
        </div>
      </div>
      <p class="muted" style="margin-bottom:1.2rem">
        Six models with the strongest current overall score. <a href="/about/#scorecard">How the score is made</a>.
      </p>
      <div class="home-model-list">
        {top.map((model, index) => {
          const overall = model.scorecard?.overall
          return (
            <div class="home-model-row">
              <span class="home-model-rank">{String(index + 1).padStart(2, "0")}</span>
              <div class="home-model-name">
                <a class="row-title" href={`/models/${model.id}/`}><h3>{model.name}</h3></a>
                <p class="mono-small">{model.organization}</p>
              </div>
              <div class="home-model-tasks">
                <TagChips tags={model.tags.filter((tag) => tag.startsWith("task:"))} limit={2} />
              </div>
              <div class="home-model-score">
                <CountPill
                  label="overall"
                  count={overall?.score == null ? "—" : Math.round(overall.score)}
                  href={`/models/${model.id}/#scorecard-overall`}
                  tone="score-overall"
                  tooltip={overall?.score == null ? "No overall score is recorded." : `Weighted mean of ${overall.coverage} of 4 axes.`}
                />
                <span class="mono-small faint">{overall?.coverage ?? 0}/4 axes</span>
              </div>
            </div>
          )
        })}
      </div>
      <div class="home-more">
        <span>{index.models.length} models in the catalogue.</span>
        <a href="/models/">See all models →</a>
      </div>
    </div>
  </section>

  <section class="section rule-top" id="compare">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Compare</p>
          <h2>Put models side by side</h2>
        </div>
      </div>
      <p class="muted" style="margin-bottom:1.2rem">
        Pick up to four models. The comparison is a separate page with the current scorecard, terms, tasks, and links.
      </p>
      <ComparePicker />
    </div>
  </section>

  <section class="section rule-top">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Start with the job</p>
          <h2>What do you need it to do?</h2>
        </div>
      </div>
      <div class="flex wrap-gap">
        {tasks.slice(0, 12).map(({ task, count }) => (
          <CountPill
            label={tagLabel(`task:${task}`)}
            count={count}
            href={tagPath(`task:${task}`)}
            tone="sage"
            tooltip={tagDefinition(`task:${task}`)}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section rule-top">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">For agents</p>
          <h2>Use the JSON</h2>
        </div>
        <a href="/data/">API and schema →</a>
      </div>
      <div class="agent-api">
        <div><code>GET /api/v1/index.json</code><p>Compact model rows, tags, and scorecard.</p></div>
        <div><code>GET /api/v1/models/&lt;id&gt;.json</code><p>The full model record.</p></div>
        <div><code>GET /api/v1/tags.json</code><p>The tag vocabulary.</p></div>
      </div>
    </div>
  </section>
</Base>
