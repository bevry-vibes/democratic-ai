---
import Base from "../layouts/Base.astro"
import { getIndex, getSyndication } from "../lib/data"

const index = getIndex()
const syndication = getSyndication()
---

<Base title="API" description="The Democratic AI catalogue JSON API: models, tags, syndication, links, and metadata.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">For consumers</p>
      <h1>The API</h1>
      <p class="lede">
        Every model page is also JSON. The API is static, versioned, and open. No key, no runtime, no tracking.
      </p>
    </div>
  </section>

  <section class="wrap detail-grid">
    <div>
      <div class="panel">
        <h2>Endpoints</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Path</th><th>Contents</th></tr></thead>
            <tbody>
              <tr><td><a href="/api/v1/index.json"><code>/api/v1/index.json</code></a></td><td>{index.models.length} compact model rows: tags, capabilities, scorecard, task performance, links.</td></tr>
              <tr><td><a href="/api/v1/models/deepseek-v4-1-flash.json"><code>/api/v1/models/&lt;id&gt;.json</code></a></td><td>The full record: summary, capabilities, scorecard, task performance, terms, lineage, builds, syndication, releases, sources.</td></tr>
              <tr><td><a href="/api/v1/tags.json"><code>/api/v1/tags.json</code></a></td><td>The tag vocabulary, definitions, and status.</td></tr>
              <tr><td><a href="/api/v1/syndication.json"><code>/api/v1/syndication.json</code></a></td><td>The score, band, weights, counts, and unavailable sources.</td></tr>
              <tr><td><a href="/api/v1/links.json"><code>/api/v1/links.json</code></a></td><td>models.dev and agent-detect links.</td></tr>
              <tr><td><a href="/api/v1/meta.json"><code>/api/v1/meta.json</code></a></td><td>Schema version, generation date, and counts.</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="panel">
        <h2>Use it</h2>
        <pre><code>{`const response = await fetch("https://democratic-ai.bevry.workers.dev/api/v1/index.json")
const { models } = await response.json()

const onDeviceSpeech = models.filter((model) =>
  model.tags.includes("domain:speech") &&
  model.tags.includes("context:on-device") &&
  model.score >= 3
)

console.log(onDeviceSpeech.map((model) => model.id))`}</code></pre>
        <p class="muted" style="font-size:0.88rem">
          A build does not have its own model record. It is attached to the base model's <code>builds</code> array.
        </p>
      </div>

      <div class="panel">
        <h2>Rules</h2>
        <ul>
          <li><code>schema_version</code> is 1. Additive changes stay inside v1.</li>
          <li>Every record carries a date. Check it before you rely on a licence.</li>
          <li>CORS is open on <code>/api/*</code>. Cache for 300 seconds.</li>
          <li>The data follows the repository licence (RPL-1.5) unless stated otherwise.</li>
        </ul>
      </div>
    </div>

    <aside>
      <div class="panel">
        <h2>At a glance</h2>
        <dl class="definition">
          <dt>Models</dt><dd>{index.models.length}</dd>
          <dt>Average score</dt><dd>{syndication.counts.average_score}/10</dd>
          <dt>Schema</dt><dd>v1</dd>
          <dt>Generated</dt><dd class="mono-small">{index.generated_at.slice(0, 10)}</dd>
        </dl>
      </div>
      <div class="panel">
        <h2>Source of truth</h2>
        <p class="muted" style="font-size:0.9rem">
          The committed records live in the repository. The API is generated from them at build time.
        </p>
        <a class="button secondary" href="https://github.com/bevry-vibes/democratic-ai/tree/main/data">Browse the data</a>
      </div>
    </aside>
  </section>
</Base>
