---
import Base from "../layouts/Base.astro"
---

<Base title="Not found" description="That page is not in the catalogue.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>That page is not in the catalogue.</h1>
      <p class="lede">The model or tag may have moved, or the link may be wrong.</p>
      <div class="hero-actions">
        <a class="button" href="/models/">Browse models</a>
        <a class="button secondary" href="/">Go home</a>
      </div>
    </div>
  </section>
</Base>
