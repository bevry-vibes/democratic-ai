{
  "lock": false,
  "tasks": {
    "fetch": "deno run -A scripts/fetch/mod.ts",
    "fetch:check": "deno check scripts/fetch/mod.ts",
    "tag": "deno run -A scripts/tag/mod.ts",
    "tag:check": "deno check scripts/tag/mod.ts scripts/tag/clef.ts",
    "tag:clef": "deno run -A scripts/tag/clef.ts",
    "links": "deno run -A scripts/links/mod.ts",
    "links:check": "deno check scripts/links/mod.ts",
    "syndication": "deno run -A scripts/syndication/mod.ts",
    "syndication:check": "deno check scripts/syndication/mod.ts",
    "index": "deno run -A scripts/index/mod.ts",
    "index:check": "deno check scripts/index/mod.ts",
    "summaries": "deno run -A scripts/summaries/fetch-cards.ts",
    "scorecard": "deno run -A scripts/scorecard/mod.ts",
    "scorecard:check": "deno check scripts/scorecard/mod.ts",
    "asr:fetch": "deno run -A scripts/asr/fetch.ts",
    "asr": "deno run -A scripts/asr/mod.ts",
    "asr:check": "deno check scripts/asr/fetch.ts scripts/asr/mod.ts",
    "overlays": "deno task benchmarks && deno task asr && deno task scorecard",
    "benchmarks:fetch": "deno run -A scripts/benchmarks/fetch.ts",
    "benchmarks": "deno run -A scripts/benchmarks/mod.ts",
    "benchmarks:check": "deno check scripts/benchmarks/fetch.ts scripts/benchmarks/mod.ts"
  },
  "imports": {
    "@std/xml": "jsr:@std/xml@^0.2.0"
  }
}
